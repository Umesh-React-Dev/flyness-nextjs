       aria-labelledby="select2-fsToStation-container"><span\n                                                    class="select2-selection__rendered"\n                                                    id="select2-fsToStation-container"><span\n                                                        class="select2-selection__placeholder">Destination</span></span><span\n                                                    class="select2-selection__arrow" role="presentation"><b\n                                                        role="presentation"></b></span></span></span><span\n                                            class="dropdown-wrapper" aria-hidden="true"></span></span>\n                                    <div class="invalid-tooltip"> Please select destination. </div>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                    <div class="col-md-5" style="display:none" id="pnlFsFlightNumber">\n                        <div class="input-station position-relative"> <input type="text"\n                                class="form-control no-focus rounded-0 border-0" placeholder="e.g. 123"\n                                id="txtFsFlightNumber">\n                            <div class="invalid-tooltip"> Please provide Flight number. </div>\n                        </div>\n                    </div>\n                    <div class="col-md-3 pt-2">\n                        <div class="custom-select"> <select id="fsDate" class="form-select border-bottom">\n                                <option value=" 2024-11-07"> TOMORROW, 07 Nov 24 </option>\n                                <option value=" 2024-11-06" selected=""> TODAY, 06 Nov 24 </option>\n                                <option value=" 2024-11-05"> YESTERDAY, 05 Nov 24 </option>\n                            </select>\n                            <div class="select-selected"> TODAY, 06 Nov 24 </div>\n                            <div class="select-items select-hide">\n                                <div> TOMORROW, 07 Nov 24 </div>\n                                <div class="select-default"> TODAY, 06 Nov 24 </div>\n                                <div> YESTERDAY, 05 Nov 24 </div>\n                            </div>\n                        </div>\n                    </div>\n                    <div class="col-md-2"> <button class="btn btn-primary rounded-1 m-0 btn-search" id="btnFsSearch"\n                            type="submit">Search</button> </div>\n                </form>\n                <div class="row m-0 pt-3 px-3 text-fs-searchby-flightnumber" style="display:none;"> <span\n                        class="text-dark">Enter flight number without carrier code.</span> </div>\n            </div>\n        </div>\n    </div>--\x3e\n</div>\n</div>',js:'// You can choose how you want to add your HTML by using insertHTMLBefore, insertHTMLAfter, or replaceHTML methods\n// e.g insertHTMLAfter(\'.someClassName\'); or insertHTMLAfter(\'body\'); or replaceHTML(\'#myPageId\')\n\n// TODO: \n// - fix insertStickyMenu(adds sticky menu on homepage)\n// - check if css stules are being added properly from cssString\n// - copy all css from dev tools again, some might be missing\n\n(function() {\n\n    let startFlag = true;\n\n    document.querySelector("body").onscroll = (event) => {\n        if (startFlag) {\n            UCstart();\n            console.log("UC 17 start");\n            startFlag = false;\n        }\n    }\n\n})();\n\nfunction UCstart() {\n    let isOnHomepage = false\n    let lang = document.documentElement.lang\n    let homePageUrl = ""\n    let hasUpcomingBooking = "{{hasUpcomingBooking}}";\n    console.log("hasUpcomingBooking: " + hasUpcomingBooking)\n\n    insertStickyMenu();\n\n    //insert new style\n    const addStyle = (() => {\n        const style = document.createElement(\'style\');\n        document.head.append(style);\n        return (styleString) => style.textContent = styleString;\n    })();\n    \n    addStyle(`\n          @media screen and (max-width: 992px) {\n            .page{\n                padding-bottom: 69px;\n            }\n            #oriDefaultTrigger{\n                bottom: 80px !important;\n            }\n            #ui-to-top.active{\n                bottom: 150px !important;\n            }\n        }\n         @media screen and (max-width: 478px) {\n            .page{\n                padding-bottom: 85px;\n            }\n            #oriDefaultTrigger{\n                bottom: 86px !important;\n            }\n            #ui-to-top.active{\n                bottom: 156px !important;\n            }\n        }\n        `);\n\n\n\n    // hasUpcomingBooking = "true" for testing\n\n    // Target elements of sticky bar on main page\n    const stickyMenu = document.querySelector(".tab-container");\n    const carSticky = document.querySelector("#rentCarListItem");\n    const flightSticky = document.querySelector(".uc1_7_container .widget-menu ul li");\n\n    hideMenuElements();\n\n    insertLinks();\n\n    function insertLinks() {\n        let panels = document.querySelectorAll(".uc1_7_container .widget-menu ul li a");\n        panels[0].addEventListener("click", function() {\n            redirect(0);\n        });\n        panels[1].addEventListener("click", function() {\n            redirect(1);\n        });\n        panels[2].addEventListener("click", function() {\n            redirect(2);\n        });\n        panels[3].addEventListener("click", function() {\n            redirect(3);\n        });\n        panels[4].addEventListener("click", function() {\n            redirect(4);\n        });\n        panels[5].addEventListener("click", function() {\n            redirect(5);\n        });\n\n    }\n    // Hide particular elemetns of sticky menu depending on if user has booking or not\n    function hideMenuElements() {\n        if (hasUpcomingBooking === "true" ) {\n            console.log("HAS BOOKING")\n            document.querySelectorAll(".uc1_7_container .widget-menu ul li")[0].style.display = "none";\n            if(!document.body.classList.contains("arabic")){\n                document.querySelectorAll(".uc1_7_container .widget-menu ul li")[1].style.borderLeft = "0";\n                \n            }\n            else{\n                document.querySelectorAll(".uc1_7_container .widget-menu ul li")[0].style.borderLeft = "0";\n                document.querySelectorAll(".uc1_7_container .widget-menu ul li")[5].style.borderLeft = "0";\n                \n            }\n            \n        } else if (hasUpcomingBooking === "false") {\n            console.log("NO BOOKING")\n            carSticky.setAttribute(\'style\', \'display: none !important\');\n            if(!document.body.classList.contains("arabic")){\n                document.querySelectorAll(".uc1_7_container .widget-menu ul li")[0].style.borderLeft = "0";\n            }\n            else{\n                document.querySelectorAll(".uc1_7_container .widget-menu ul li")[4].style.borderLeft = "0";\n                \n            }\n        }\n    }\n\n\n\n    // Check if on homepage\n    function hasPathAfterBaseUrl() {\n        const baseUrl = \'https://digital1.flynas.com/\';\n        const url = window.location.href;\n        return isOnHomepage = url.startsWith(baseUrl) && url.length <= baseUrl.length;\n    }\n\n    console.log("is homepage: " + hasPathAfterBaseUrl())\n\n    // If not on homepage insert sticky menu\n    function insertStickyMenu(html) {\n        const transl = {\n            flight: " حجز رحلة",\n            hotel: "رحلة  + الفندق",\n            manage: " إدارة الحجز",\n            checkin: " بطاقة الصعود ",\n            status: "حالة الرحلة",\n            rentCar: "استئجار سيارة"\n        }\n\n        if (isOnHomepage == true) {\n            console.log("insertStickyMenu: " + isOnHomepageisOnHomepage)\n            hideMenuElements()\n        } else {\n            console.log(