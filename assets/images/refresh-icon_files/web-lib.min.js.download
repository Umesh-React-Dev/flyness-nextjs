"NJF": "Najaf",\r\n\t"SHJ": "Sharjah"\r\n  }\r\n\r\n        const flightsButton = document.querySelector(".btn-primary")\r\n        let reminderText = document.querySelectorAll(".reminder-text")\r\n        let searchButton = document.querySelectorAll(".search-button")\r\n        // let searchPane = document.getElementsByTagName("app-flight-search")[1]\r\n\r\n        var maxWidth = window.matchMedia("(max-width: 768px)")\r\n        var minWidth = window.matchMedia("(min-width: 767px)")\r\n\r\n        var uc_1_1_interval = setInterval(function () {\r\n            if (flightsButton != null) {\r\n                let transl = appendText();\r\n                if (href.includes("ibeuat")) {\r\n                    //   alert("ibeuat")\r\n                    insertHTMLAfter(\'#ngb-nav-0-panel\');\r\n                    insertHTMLAfter(searchPane);\r\n                    clearInterval(uc_1_1_interval)\r\n                    reminderText = document.querySelectorAll(".reminder-text")\r\n                    searchButton = document.querySelectorAll(".search-button")\r\n\r\n                }\r\n                // else if(href.includes("ibeuat") && minWidth.matches) {\r\n                //     insertHTMLAfter(\'.tab-content-mobile\');\r\n                //     clearInterval(uc_1_1_interval)\r\n                //     reminderText = document.querySelectorAll(".reminder-text")\r\n                //     searchButton = document.querySelectorAll(".search-button")\r\n                //     return appendText(reminderText, searchButton)\r\n                // }\r\n                else {\r\n                    console.log("CMS")\r\n                    insertHTMLAfter(\'.mobile-style\');\r\n                    clearInterval(uc_1_1_interval)\r\n                    document.querySelectorAll(".reminder-text")[0].innerHTML = transl["Text"];\r\n                    document.querySelectorAll(".search-button")[0].innerHTML = transl["Button"];\r\n                    document.querySelectorAll(".reminder-text")[1].innerHTML = transl["TextMobile"];\r\n                    document.querySelectorAll(".search-button")[1].innerHTML = transl["Button"];\r\n                    if (lang === "ar") {\r\n                        document.querySelectorAll(".search-button")[0].style.float = "left";\r\n                    }\r\n                    document.querySelectorAll(".search-button")[0].href = link;\r\n                    document.querySelectorAll(".search-button")[1].href = link;\r\n\r\n                }\r\n            }\r\n        }, 100)\r\n\r\n        function appendText() {\r\n            /*\r\n            let engText = `Hello ${guestName}, planning a trip to <span class="highlight">${airports[destination]}</span>? Price starts from <span class="highlight">${lowestFarePrice} ${currency}</span>!`;\r\n            //let engText = `Hey there! Still thinking about that trip to <span class="highlight">${airports[destination]}</span>? Now’s your chance – flights start from just <span class="highlight">${lowestFarePrice} ${currency}</span>!`;\r\n\r\n            let arText = `أهلاً ${guestName}، تخطط لرحلة إلى  <span class="highlight">${airportsTranslated[destination]}</span>؟ الأسعار تبدأ من <span class="highlight"> ${lowestFarePrice} ${currencyTranslated[currency]} </span>!`;\r\n\r\n            let engTextMobile = `Hello ${guestName}, planning a trip to <span class="highlight">${airports[destination]}</span>?<br> Price starts from <span class="highlight">${lowestFarePrice} ${currency}</span>!`;\r\n            let arTextMobile = `أهلاً ${guestName}، تخطط لرحلة إلى  <span class="highlight">${airportsTranslated[destination]}</span>؟ <br>الأسعار تبدأ من <span class="highlight"> ${lowestFarePrice} ${currencyTranslated[currency]} </span>!`;*/\r\n            \r\n            if (isGuest == false) {\r\n                              engText = `Hello ${guestName}, planning a trip to <span class="highlight">${airports[destination]}</span>? Price starts from <span class="highlight">${lowestFarePrice} ${currency}</span>!`;\r\n             engTextMobile = `Hello ${guestName}, planning a trip to <span class="highlight">${airports[destination]}</span>?<br> Price starts from <span class="highlight">${lowestFarePrice} ${currency}</span>!`;\r\n\r\n             arText = `أهلاً ${guestName}، تخطط لرحلة إلى  <span class="highlight">${airportsTranslated[destination]}</span>؟ الأسعار تبدأ من <span class="highlight"> ${lowestFarePrice} ${currencyTranslated[currency]} </span>!`;\r\n\r\n            arTextMobile = `أهلاً ${guestName}، تخطط لرحلة إلى  <span class="highlight">${airportsTranslated[destination]}</span>؟ <br>الأسعار تبدأ من <span class="highlight"> ${lowestFarePrice} ${currencyTranslated[currency]} </span>!`;\r\n\r\n            }\r\n            else {\r\n                \r\n                 engText = `Hey there! Still thinking about that trip to <span class="highlight">${airports[destination]}</span>? Now’s your chance – flights start from just <span class="highlight">${lowestFarePrice} ${currency}</span>!`;\r\n\r\n             arText = `أهلاً! تفكر في رحلة إلى <span class="highlight">${airportsTranslated[destination]}</span> استغل الفرصة! الأسعار تبدأ من <span class="highlight"> ${lowestFarePrice} ${currencyTranslated[currency]} </span> بس!`;\r\n\r\n\r\n            \r\n             engTextMobile = `Hey there! Still thinking about that trip to <span class="highlight">${airports[destination]}</span>?<br> Now’s your chance – flights start from just <span class="highlight">${lowestFarePrice} ${currency}</span>!`;\r\n\r\n\r\n             arTextMobile = `أهلاً! تفكر في رحلة إلى <span class="highlight">${airportsTranslated[destination]}</span>؟ <br> استغل الفرصة! الأسعار تبدأ من <span class="highlight"> ${lowestFarePrice} ${currencyTranslated[currency]} </span> بس!`;\r\n            }\r\n            \r\n\r\n            \r\n            let engButton = "Continue Your Search >>"\r\n            let arButton = "تابع بحثك\t>>"\r\n\r\n            // Check language on site and append text\r\n            if (lang === "en") {\r\n                return {\r\n                    "Text": engText,\r\n                    "Button": engButton,\r\n                    "TextMobile": engTextMobile\r\n\r\n                }\r\n            } else if (lang === "ar") {\r\n                return {\r\n                    "Text": arText,\r\n                    "Button": arButton,\r\n                    "TextMobile": arTextMobile\r\n                }\r\n            }\r\n        }\r\n\r\n    }\r\n})();'}}],notificationEnabled:!1},{ref:"c29130b6-5401-4af4-bf39-8370b59397d6",name:"UC 1.2 Hiro image Homepage - PC-486",revision:13,archived:!1,target:{script:"// Use client-side JavaScript to more specifically target users\n// NOTE: When your targeting conditions are met you must call targetingPassed() \n\n(function () {\n    console.log(\"pathname \"+window.location.pathname);\n    let onBookingPage = false\n    if(window.location.host.includes(\"booking\")) {\n        onBookingPage = true\n    }\n    \n    if(window.location.pathname === '' || (window.location.pathname === '/' && onBookingPage == false) || window.location.pathname.includes(\"home\") \n    || window.location.pathname === '/en' || window.location.pathname === '/ar'){\n        if(!window.location.pathname.includes(\"ru\"))\n            targetingPassed();    \n    }\n    \n})();",targetPages:[]},traffic:{type:"advancedTraffic",allocationLow:1,allocationHigh:120,splits:[{ref:"854d6c29-77ee-4607-a671-cf4f87b6db8e",lowSplit:1,highSplit:6},{ref:"076f5cc9-8880-4322-a27b-f154a2dc0181",lowSplit:7,highSplit:120}],coupled:!1},variants:[{ref:"854d6c29-77ee-4607-a671-cf4f87b6db8e",name:"Original",assets:{css:"/** style your Experience with CSS */",html:"\x3c!-- define the structure and content of your Experience in HTML e.g.--\x3e\n<div>My Content</div>\n\x3c!-- Use dynamic Guest variables, type ctrl+space or guest to explore available entities.--\x3e\n\x3c!-- Type 'd' to see decisioning helpers --\x3e\n",js:"// You can choose how you want to add your HTML by using insertHTMLBefore, insertHTMLAfter, or replaceHTML methods\n// e.g insertHTMLAfter('.someClassName'); or insertHTMLAfter('body'); or replaceHTML('#myPageId')\n\n/*\n\n(function () {\n  // Add statements here\n})();\n\n*/"}},{ref:"076f5cc9-8880-4322-a27b-f154a2dc0181",name:"Variant 1",assets:{css:"#newDiv_1_2{\n    height : 500px;\n    overflow : hidden;\n    width : 100%;\n    margin-bottom : 120px;\n}\n\n",html:'\x3c!-- define the structure and content of your Experience in HTML e.g.--\x3e\n<div id="urltest"><a href="https://booking.flynas.com/#/manage/search?lang=en-US"></a></div>\n\x3c!-- Use dynamic Guest variables, type ctrl+space or guest to explore available entities.--\x3e\n\x3c!-- Type \'d\' to see decisioning helpers --\x3e\n\n',js:'(function() {\r\n\r\n    let lang;\r\n    if (document.body.classList.contains("arabic")) {\r\n        lang = "ar";\r\n    } else {\r\n        lang = "en";\r\n    }\r\n    let parentElement = document.querySelector(".swiper-form-wrap");\r\n    let htmlVerios = "bag";\r\n    const firstName = "{{audienceFilter.firstName}}";\r\n    // const firstName = "Piotr";\r\n\r\n    if ("{{audienceFilter.bag}}" === "0")\r\n        htmlVerios = "bag";\r\n    else if ("{{audienceFilter.bag}}" === "1" && "{{audienceFilter.meal}}" === "0")\r\n        htmlVerios = "meal";\r\n    else if ("{{audienceFilter.bag}}" === "1" && "{{audienceFilter.meal}}" === "1" && "{{audienceFilter.seat}}" === "0")\r\n        htmlVerios = "seat";\r\n\r\n    let html = "";\r\n\r\n    let text;\r\n    let img = {\r\n        "bag": "https://static.flynas.com/images/HostedLinks/No_Baggage_Booked/Personalized_Hompage_No_Baggage_Booked_1920X780.jpg",\r\n        "seat": "https://static.flynas.com/images/HostedLinks/No_Seat_Upgrade/Personalized_Hompage_No-Seat_Upgrade_1920X780_copy_4.jpg",\r\n        "meal": "https://static.flynas.com/images/HostedLinks/No_Meal_Booked/Personalized_Hompage_No_Meal_1920X780.jpg"\r\n    }\r\n\r\n    let style;\r\n\r\n    switch (lang) {\r\n        case "en-eu":\r\n        case "en-ae":\r\n        case "en":\r\n            text = {\r\n                "bag": [firstName + \' don’t forget your baggage needs!\', \'Add Baggage Now\'],\r\n                "seat": [\'Get the best seat in the house\', \'Change Now\'],\r\n                "meal": [\'Pre-order Meals\', \'Add Now\', "Don\'t go hungry, pre-order your meal today!", ]\r\n            }\r\n            style = {\r\n                textBackground_right: "0px",\r\n                textBackground_left: "220px",\r\n\r\n                uc1_2_btn_right: "0px",\r\n                uc1_2_btn_left: "220px",\r\n\r\n\r\n                uc1_2_btn_top: "140px"\r\n\r\n            }\r\n            break;\r\n        case "ar-ae":\r\n        case "ar":\r\n            text = {\r\n                bag: [firstName + \'تحتاج وزن إضافي للأمتعة؟ \', \'أضف الأمتعة الآن\'],\r\n                seat: [\'احصل على أفضل مقعد في المكان\', \'غيّر الآن\'],\r\n                meal: [\'وجبات مسبقة الدفع\', \'أضف الآن\', "استمتع برحلتك بدون جوع، اطلب وجبتك الآن!"]\r\n            }\r\n            style = {\r\n                textBackground_right: "220px",\r\n                textBackground_left: "0px",\r\n\r\n                uc1_2_btn_right: "220px",\r\n                uc1_2_btn_left: "0px",\r\n\r\n\r\n                uc1_2_btn_top: "140px"\r\n            }\r\n            break;\r\n    }\r\n\r\n    let html2 = "";\r\n    if (htmlVerios === "meal") {\r\n        html2 = \'<h4>\' + text[htmlVerios][2] + \'</h4>\';\r\n    }\r\n    html = \'<div class="imgContainer">\' +\r\n        \'<div class="textBackground"><h2>\' + text[htmlVerios][0] + \'</h2>\' +\r\n        html2 +\r\n        \'</div>\' +\r\n        \'<button class="btn btn-primary m-0 rounded-5" id="uc1_2_btn">\' + text[htmlVerios][1] + \'</button>\' +\r\n        \'</div>\';\r\n\r\n    let newDiv = document.createElement("div");\r\n    newDiv.id = "newDiv_1_2";\r\n    newDiv.innerHTML = html;\r\n\r\n    parentElement.replaceChildren();\r\n    parentElement.appendChild(newDiv);\r\n\r\n    sendCustomEvent("1_2_SHOWN");\r\n    // newDiv.style.border = "10px solid #ffffff";\r\n\r\n\r\n    let imgContainer = document.querySelector("#newDiv_1_2 .imgContainer");\r\n    //imgContainer CSS\r\n    imgContainer.style.width = "100%";\r\n    imgContainer.style.height = "500px";\r\n    imgContainer.style.backgroundImage = "url(\'" + img[htmlVerios] + "\')";\r\n    imgContainer.style.backgroundRepeat = "no-repeat";\r\n    imgContainer.style.backgroundSize = "cover";\r\n\r\n\r\n    //redBackground CSS\r\n    let textBackground = document.querySelector("#newDiv_1_2 .textBackground");\r\n\r\n    textBackground.style.width = "fit-content";\r\n    // textBackground.style.height = "40px";\r\n    textBackground.style.backgroundColor = "rgb(0 191 179 / 70%)";\r\n    // redBackground.style.margin = "auto";\r\n    textBackground.style.top = "130px";\r\n    textBackground.style.left = style.textBackground_left;\r\n    textBackground.style.right = style.textBackground_right;\r\n    textBackground.style.position = "relative";\r\n    textBackground.style.borderRadius = "40px";\r\n    // textBackground.style.textAlign = "center";\r\n    textBackground.style.padding = "5px 20px 2px 20px";\r\n    textBackground.style.color = "black";\r\n\r\n\r\n    //uc1_2_btn CSS \r\n    let uc1_2_btn = document.querySelector("#newDiv_1_2 #uc1_2_btn");\r\n\r\n\r\n    uc1_2_btn.style.left = style.uc1_2_btn_left;\r\n    uc1_2_btn.style.right = style.uc1_2_btn_right;\r\n\r\n    uc1_2_btn.style.top = style.uc1_2_btn_top;\r\n    uc1_2_btn.style.position = "relative";\r\n    uc1_2_btn.style.fontWeight = "bold";\r\n    uc1_2_btn.style.fontSize = "20px";\r\n\r\n    uc1_2_btn.addEventListener("click", onBtnClick);\r\n\r\n    function onBtnClick() {\r\n        sendCustomEvent("1_2_CLICK");\r\n\r\n        let newlang;\r\n        if (lang === "en") {\r\n            newlang = "en-US";\r\n        } else {\r\n            newlang = "en-GB";\r\n        }\r\n        setTimeout(function() {\r\n            if (window.location.hostname === \'www.flynas.com\') {\r\n                window.location.href = "https://booking.flynas.com/#/manage/search?lang=" + newlang;\r\n            } else {\r\n                window.location.href = "https://ibeuat.flynas.com/flynascdp/#/manage/search?lang=" + newlang;\r\n            }\r\n        }, 500);\r\n\r\n        // https://booking.flynas.com/#/manage/search?lang=en-US\r\n        // https://booking.flynas.com/#/manage/search?lang=en-GB\r\n\r\n    }\r\n\r\n    function sendCustomEvent(type) {\r\n        const eventData2 = {\r\n            channel: "WEB",\r\n            currency: "EUR",\r\n            pointOfSale: Engage.settings.pointOfSale,\r\n            language: "EN",\r\n            page: location.pathname\r\n        };\r\n        engage.event(type, eventData2);\r\n    }\r\n\r\n})();'}}],notificationEnabled:!1},{ref:"9fd2f3de-7390-4044-a23d-ab207d03c289",name:"UC1.5b v1.2 Dwell time Payment page",revision:26,archived:!1,target:{script:"// Use client-side JavaScript to more specifically target users\n// NOTE: When your targeting conditions are met you must call targetingPassed() \n\nvar targeting_flag = 1;\n\tvar page_margin_interval  = setInterval(function() {\n  \ttry{\n      \tif(targeting_flag == 1){\n        \tif (window.location.href.includes(\"/booking/payment\")){\n        \t    clearInterval(page_margin_interval);\n                targetingPassed();\n        \t}\n        \telse{\n        \t    throw 'Targeting not found';\n        \t}\n      \t}\n     \ttargeting_flag = 0;\n     \tclearInterval(page_margin_interval);\n  \t}  \n  \tcatch{}\n\t}, 500);",targetPages:[]},traffic:{type:"advancedTraffic",allocationLow:1,allocationHigh:120,splits:[{ref:"c4fe32d9-53f3-40eb-a089-8545f9b40233",lowSplit:1,highSplit:30},{ref:"991037ec-7e9b-4de6-830b-fc77118741db",lowSplit:31,highSplit:120}],coupled:!1},variants:[{ref:"c4fe32d9-53f3-40eb-a089-8545f9b40233",name:"Original",assets:{css:"/** style your Experience with CSS */",html:"\x3c!-- define the structure and content of your Experience in HTML e.g.--\x3e\n{{!--<div>My Content</div>--}}\n\x3c!-- Use dynamic Guest variables, type ctrl+space or guest to explore available entities.--\x3e\n\x3c!-- Type 'd' to see decisioning helpers --\x3e\n",js:'// You can choose how you want to add your HTML by using insertHTMLBefore, insertHTMLAfter, or replaceHTML methods\n// e.g insertHTMLAfter(\'.someClassName\'); or insertHTMLAfter(\'body\'); or replaceHTML(\'#myPageId\')\n\n(function () {\n\n//console.log("start");\nlet lastMouseMoveTime \n\nlet id_flag = 1\n// Setting time    \nvar timeDelay = 45 * 1000\n\n// Sending event each time variant triggers for KPIs\nfunction sendGoalEvent() {\n    //console.log("IN_TIMEOUT");\n    const eventData2 = {\n        channel: "WEB",\n        currency: "EUR",\n        pointOfSale: Engage.settings.pointOfSale,\n        language: "EN",\n        page: location.pathname\n    };\n\n    engage.event("UC_1_5_B_TRIGGER_CONTROL", eventData2);\n}\n\nsendGoalEvent()\n  \n// Sending event after 45s of inactivity for KPIs\nfunction sendTimedoutGoalEvent() {\n    //console.log("IN_TIMEOUT");\n    const eventData2 = {\n        channel: "WEB",\n        currency: "EUR",\n        pointOfSale: Engage.settings.pointOfSale,\n        language: "EN",\n        page: location.pathname\n    };\n\n\n\n    engage.event("UC_1_5_B_USER_TIMED_OUT_CONTROL", eventData2);\n}\n\nwindow.addEventListener("mousemove", function () {\n     lastMouseMoveTime = Date.now()\n});\n\nfunction startCountDown() {\n    //console.log("IN_COUNTDOWN");\n    // alert("startCountDown")\n    var uc_1_5_interval = setInterval(function () {\n        if (id_flag === 1) {\n            //console.log("IF 1");\n            var calc = Date.now() - lastMouseMoveTime;\n            if (calc > timeDelay && window.location.href.includes("booking/payment")) {\n                //console.log("IF 2");\n                sendTimedoutGoalEvent()\n                id_flag = 0;\n                clearInterval(uc_1_5_interval)\n            }\n\n        }\n\n\n    }, 100);\n}\n  \nstartCountDown();\n//console.log("END");\n  \n})();'}},{ref:"991037ec-7e9b-4de6-830b-fc77118741db",name:"Variant 1 - Popup takeover 45s",assets:{css:"/*\r\n#fff\r\n\r\nGothamRounded-Book;\r\n#4D4D4D\r\n36\r\n#4D4D4D\r\n16\r\n#fff\r\n#000000\r\n#9e9e9e\r\n#fff\r\n16\r\n*/\r\n\r\n@font-face {\r\n    font-family: 'flynas-Bold';\r\n    src: url('./fonts/Flynas-Bold.eot');\r\n    src: url('./fonts/Flynas-Bold.eot?#iefix') format('embedded-opentype'), url('./fonts/Flynas-Bold.woff2') format('woff2'), url('./fonts/Flynas-Bold.woff') format('woff'), url('./fonts/Flynas-Bold.ttf') format('truetype'), url('./fonts/Flynas-Bold.svg#Flynas-Bold') format('svg');\r\n    font-weight: bold;\r\n    font-style: normal;\r\n    font-display: swap;\r\n}\r\n\r\n@font-face {\r\nfont-family: 'flynas-Thin';\r\nsrc: url('./fonts/Flynas-Thin.eot');\r\nsrc: url('./fonts/Flynas-Thin.eot?#iefix') format('embedded-opentype'), url('./fonts/Flynas-Thin.woff2') format('woff2'), url('./fonts/Flynas-Thin.woff') format('woff'), url('./fonts/Flynas-Thin.ttf') format('truetype'), url('./fonts/Flynas-Thin.svg#Flynas-Thin') format('svg');\r\nfont-weight: 100;\r\nfont-style: normal;\r\nfont-display: swap;\r\n}\r\n\r\n@font-face {\r\nfont-family: 'flynas-Light';\r\nsrc: url('./fonts/Flynas-Light.eot');\r\nsrc: url('./fonts/Flynas-Light.eot?#iefix') format('embedded-opentype'), url('./fonts/Flynas-Light.woff2') format('woff2'), url('./fonts/Flynas-Light.woff') format('woff'), url('./fonts/Flynas-Light.ttf') format('truetype'), url('./fonts/Flynas-Light.svg#Flynas-Light') format('svg');\r\nfont-weight: 300;\r\nfont-style: normal;\r\nfont-display: swap;\r\n}\r\n\r\n@font-face {\r\nfont-family: 'flynas-Regular';\r\nsrc: url('./fonts/Flynas-Regular.eot');\r\nsrc: url('./fonts/Flynas-Regular.eot?#iefix') format('embedded-opentype'), url('./fonts/Flynas-Regular.woff2') format('woff2'), url('./fonts/Flynas-Regular.woff') format('woff'), url('./fonts/Flynas-Regular.ttf') format('truetype'), url('./fonts/Flynas-Regular.svg#Flynas-Regular') format('svg');\r\nfont-weight: normal;\r\nfont-style: normal;\r\nfont-display: swap;\r\n}\r\n\r\n@font-face {\r\nfont-family: 'flynas-Medium';\r\nsrc: url('./fonts/Flynas-Medium.eot');\r\nsrc: url('./fonts/Flynas-Medium.eot?#iefix') format('embedded-opentype'), url('./fonts/Flynas-Medium.woff2') format('woff2'), url('./fonts/Flynas-Medium.woff') format('woff'), url('./fonts/Flynas-Medium.ttf') format('truetype'), url('./fonts/Flynas-Medium.svg#Flynas-Medium') format('svg');\r\nfont-weight: 500;\r\nfont-style: normal;\r\nfont-display: swap;\r\n}\r\n\r\n@font-face {\r\nfont-family: 'flynas-SemiBold';\r\nsrc: url('./fonts/Flynas-SemiBold.eot');\r\nsrc: url('./fonts/Flynas-SemiBold.eot?#iefix') format('embedded-opentype'), url('./fonts/Flynas-SemiBold.woff2') format('woff2'), url('./fonts/Flynas-SemiBold.woff') format('woff'), url('./fonts/Flynas-SemiBold.ttf') format('truetype'), url('./fonts/Flynas-SemiBold.svg#Flynas-SemiBold') format('svg');\r\nfont-weight: 600;\r\nfont-style: normal;\r\nfont-display: swap;\r\n}\r\n\r\n@font-face {\r\nfont-family: 'Flynas-ExtraBold';\r\nsrc: url('./fonts/Flynas-ExtraBold.eot');\r\nsrc: url('./fonts/Flynas-ExtraBold.eot?#iefix') format('embedded-opentype'), url('./fonts/Flynas-ExtraBold.woff2') format('woff2'), url('./fonts/Flynas-ExtraBold.woff') format('woff'), url('Flynas-ExtraBold.ttf') format('truetype'), url('./fonts/Flynas-ExtraBold.svg#Flynas-ExtraBold') format('svg');\r\nfont-weight: bold;\r\nfont-style: normal;\r\nfont-display: swap;\r\n}\r\n\r\n\r\n.UC_grid {\r\ndisplay: grid;\r\ngrid: 140px / 32% 48% 21%;\r\nmargin-top: 5px;\r\n}\r\n\r\n.arabic .pers-modal_content {\r\ntransform: scaleX(-1);\r\n}\r\n\r\n.arabic .UC_grid {\r\ntransform: scaleX(-1);\r\n}\r\n\r\n.arabic .pers-modal__btn-close-icon{\r\nbackground: transparent;\r\ntop: -16px;\r\nright: 81px;\r\nwidth: 7px;\r\nheight: 2px;\r\nposition: relative;\r\ncursor: pointer;\r\n}\r\n\r\n\r\n#pers-{{ref}} a,\r\n#pers-{{ref}} p,\r\n#pers-{{ref}} span,\r\n#pers-{{ref}} h3 {\r\nfont-family: flynas-Regular;\r\nfont-weight: 400;\r\nline-height: 1.2;\r\n}\r\n\r\n/*#pers-{{ref}} #pers-modal_overlay {*/\r\n/*  display: none;*/\r\n/*  justify-content: center;*/\r\n/*  align-items: center;*/\r\n/*  position: fixed;*/\r\n/*  z-index: 999999;*/\r\n/*  left: 0;*/\r\n/*  top: 0;*/\r\n/*  width: 100%;*/\r\n/*  height: 100%;*/\r\n/*  overflow: hidden;*/\r\n/*  background-color: rgba(0,0,0,0.4);*/\r\n/*  font-family: flynas-Regular;*/\r\n/*}*/\r\n#pers-{{ref}} #pers-modal_overlay {\r\ndisplay: none;\r\n\r\n/*PC-174*/\r\nanimation-duration: 0.5s;\r\nopacity: 1;\r\nanimation-name: fade-in;\r\nanimation-play-state: paused;\r\nanimation-fill-mode: forwards;\r\n\r\njustify-content: center;\r\nalign-items: center;\r\nposition: fixed;\r\nz-index: 999999;\r\nleft: 0;\r\ntop: 0;\r\nwidth: 100%;\r\nheight: 100%;\r\noverflow: hidden;\r\nbackground-color: rgba(0,0,0,0.4);\r\nfont-family: flynas-Regular;\r\n}\r\n\r\n/*PC-174*/\r\n@keyframes fade-in{\r\n0%   {\r\nopacity: 0;\r\n}\r\n100%   {\r\nopacity: 1;\r\n\r\n}\r\n}\r\n/*PC-174*/\r\n@keyframes fade-out{\r\n0%   {\r\nopacity: 1;\r\n}\r\n100%   {\r\nopacity: 0;\r\n\r\n}\r\n}\r\n\r\n#pers-{{ref}} #pers-modal_overlay .pers-modal_content {\r\ndisplay: flex;\r\nflex-direction: column;\r\nposition:relative;\r\nbackground: #fff;\r\nmargin: 0 auto;\r\nborder-radius: 4px;\r\n/*box-shadow: 0 2px 10px 6px rgba(0,0,0,0.3);*/\r\nwidth: 650px;\r\nmin-height: 380px;\r\nborder: none;\r\npadding: 20px 38px;\r\nbackground: url(https://static.flynas.com/images/HostedLinks/Pop-Ups/Pop-Ups/Payment-Page.png);\r\nbackground-repeat: no-repeat;\r\nbackground-size: 100%;\r\n}\r\n\r\n#pers-{{ref}} #pers-modal_overlay .pers-modal_content h3 {\r\npadding: 12px 50px 12px 50px;\r\nline-height: 1.5;\r\nfont-size: 36;\r\nfont-weight: bold;\r\nmargin: auto;\r\ncolor: #4D4D4D;\r\nfont-family: flynas-Regular;\r\ntext-align: center;\r\n}\r\n\r\n#pers-{{ref}} #pers-modal_overlay .pers-modal_content p {\r\nmargin: 0;\r\npadding-top:90px;\r\nfont-size: 16px;\r\nfont-weight: bold;\r\nline-height: 28px;\r\ncolor: white;\r\nfont-family: flynas-Regular;\r\ntext-align: center;\r\n}\r\n\r\n#pers-{{ref}} #pers-modal_overlay .pers-modal_button-wrapper {\r\ndisplay: flex;\r\nmargin-top: auto;\r\nmargin: auto;\r\n}\r\n\r\n#pers-{{ref}} #pers-modal_overlay .pers-modal_button {\r\ndisplay: inline-block;\r\nborder-radius: 4px;\r\ntext-decoration: none;\r\ncolor: #fff;\r\nbackground-color: #000000;\r\npadding: 12px 53px;\r\nfont-size: 18px;\r\nfont-weight: bold;\r\n}\r\n\r\n#pers-{{ref}} #pers-modal_overlay .pers-modal_button:hover {\r\ncolor: #fff;\r\nbackground-color: #9e9e9e;\r\n}\r\n\r\n#pers-{{ref}} #pers-modal_overlay .pers-modal_dismiss-wrapper {\r\ndisplay: flex;\r\nmargin-top: auto;\r\nmargin: auto;\r\nmargin-left :25px;\r\n}\r\n\r\n#pers-{{ref}} #pers-modal_overlay .pers-modal_dismiss {\r\ndisplay: inline-block;\r\nborder-radius: 4px;\r\nmargin-left :25px;\r\ncolor: #fff;\r\npadding: 10px 23px;\r\n}\r\n\r\n/* close button */\r\n#pers-{{ref}} .pers-modal__btn-close-icon {\r\nbackground: transparent;\r\ntop: -17px;\r\nwidth: 7px;\r\nheight: 2px;\r\nposition: relative;\r\ncursor: pointer;\r\n}\r\n#pers-{{ref}} .uc_ar .pers-modal__btn-close-icon {\r\n    right: 100px;\r\n}\r\n#pers-{{ref}} .uc_en .pers-modal__btn-close-icon {\r\n    right: -82px;\r\n}\r\n\r\n\r\n#pers-{{ref}} .pers-modal__btn-close-icon:after {\r\nbackground: transparent;\r\ncontent: \"\";\r\nheight: 20px;\r\nborder-left: 3px solid #df0f48;\r\nposition: absolute;\r\nmargin: auto;\r\ntransform: rotate(45deg);\r\n}\r\n\r\n#pers-{{ref}} .pers-modal__btn-close-icon:before {\r\nbackground: transparent;\r\ncontent: \"\";\r\nheight: 20px;\r\nborder-left: 3px solid #df0f48;\r\nmargin: auto;\r\nposition: absolute;\r\ntransform: rotate(-45deg);\r\n}\r\n\r\n@media only screen and (max-width: 575px)  {\r\n\r\n#pers-{{ref}} .uc_en .pers-modal_content p {\r\npadding-top: 25px !important;\r\n    \r\n}\r\n#pers-{{ref}} .uc_ar .pers-modal_content p {\r\npadding-top: 25px !important;\r\n    \r\n}\r\n}\r\n\r\n@media only screen and (max-width: 450px)  {\r\n\r\n#pers-{{ref}} #pers-modal_overlay .pers-modal_content p {\r\nfont-size: 11px !important;\r\n}\r\n/*PC-182 - \"X\" button hiding on screen narrower than 450px*/\r\n    #pers-{{ref}} .uc_ar .pers-modal__btn-close-icon{\r\n        right: 80px;\r\n    }\r\n    \r\n    #pers-{{ref}} .uc_ar .pers-modal_content p{\r\n        padding-top: 40px !important;\r\n    }\r\n\r\n    #pers-{{ref}} .uc_en .pers-modal__btn-close-icon{\r\n        right: -80px;\r\n    }\r\n    #pers-{{ref}} .uc_en .pers-modal_content p{\r\n        padding-top: 10px !important;\r\n    }\r\n}\r\n\r\n",html:'\x3c!-- Use dynamic Guest variables, type ctrl+space or guest to explore available entities.--\x3e\n\x3c!-- Type "d" to see decisioning helpers --\x3e\n<div id="pers-modal_overlay">\n  <div class="pers-modal_content">\n   <div class="UC_grid">\n       <div></div>\n       <p>\n      Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat.\n    </p>\n    <div class="pers-modal__btn-close-icon"></div>\n   </div>\n    \n    \n  </div>\n</div>',js:'// Adds a unique variant identifier to CSS when deployed to ensure CSS does not impact styling of other elements.\r\nconsole.log("____UC START____")\r\nvar flag_booking = "{{flags.booking}}";\r\nvar flag_search = "{{flags.search}}";\r\nvar lastMouseMoveTime = Date.now();\r\nvar timeDelay = 45 * 1000\r\n\r\n// FOR TESTING COMMENT OUT BEFORE PUBLISHING\r\n// flag_booking = "0"\r\n// flag_search = "1"\r\n// timeDelay = 1000\r\n\r\nvar id_flag = 1;\r\nvar compiledCSS = Engage.templating.compile(variant.assets.css)(variant);\r\nvar styleTag = document.getElementById(\'style-\' + variant.ref);\r\nif (styleTag) {\r\n    styleTag.innerHTML = compiledCSS;\r\n}\r\n\r\nvar supportedLangs = [\'ar\', \'en\']\r\n\r\n\r\n// End Adds a unique variant identifier to CSS when deployed to ensure CSS does not impact styling of other elements.\r\n\r\n// Sending event each time variant triggers for KPIs\r\nfunction sendGoalEvent() {\r\n    //console.log("IN_TIMEOUT");\r\n    const eventData2 = {\r\n        channel: "WEB",\r\n        currency: "EUR",\r\n        pointOfSale: Engage.settings.pointOfSale,\r\n        language: "EN",\r\n        page: location.pathname\r\n    };\r\n\r\n    engage.event("UC_1_5_B_TRIGGER_VARIANT1", eventData2);\r\n}\r\n\r\nsendGoalEvent()\r\n\r\nfunction sendTimedoutGoalEvent() {\r\n    const eventData2 = {\r\n        channel: "WEB",\r\n        currency: "EUR",\r\n        pointOfSale: Engage.settings.pointOfSale,\r\n        language: "EN",\r\n        page: location.pathname\r\n    };\r\n\r\n\r\n\r\n    engage.event("UC_1_5_B_USER_TIMED_OUT", eventData2);\r\n}\r\n\r\n\r\n// make space in the body for the experience\r\n/*PC-174*/\r\nfunction popup() {\r\n    var lang = document.documentElement.lang.toLowerCase()\r\n    if (supportedLangs.includes(lang)) {\r\n        console.log("____POPUP____")\r\n        insertHTMLBefore(\'body\', \'pers-\');\r\n        sendTimedoutGoalEvent()\r\n\r\n        translateContent(lang)\r\n        let parentEl = document.querySelector(\'#pers-modal_overlay\');\r\n        parentEl.style.display = \'flex\';\r\n        parentEl.style.animationPlayState = "running";\r\n\r\n        document.body.classList.add(\'pers-modal_content\');\r\n        var persCardClose = document.querySelector(\'.pers-modal__btn-close-icon\');\r\n        const persContentCard = document.querySelector(\'.pers-modal_content\')\r\n        const text = document.querySelector(".pers-modal_content p")\r\n        \r\n        //PC-182 - "X" button hiding on screen narrower than 450px\r\n        if(lang === "ar"){\r\n            parentEl.classList.add("uc_ar")\r\n        }\r\n        else{\r\n            parentEl.classList.add("uc_en")\r\n        }\r\n        \r\n        persCardClose.addEventListener(\'click\', function() {\r\n            setTimeout(function () {\r\n            document.querySelector(\'#pers-modal_overlay\').style.display = \'none\';\r\n            }, 500);\r\n\r\n            document.querySelector(\'#pers-modal_overlay\').style.animationName = "fade-out";\r\n        });\r\n    \r\n// UC1.5a & b closing popup usability fixes\r\n    document.addEventListener(\'click\', function(event) {\r\n      if(!document.querySelector("#pers-modal_overlay > div > div").contains(event.target))\r\n        setTimeout(function () {\r\n            document.querySelector(\'#pers-modal_overlay\').style.display = \'none\';\r\n        }, 500);\r\n\r\n        document.querySelector(\'#pers-modal_overlay\').style.animationName = "fade-out";\r\n    });\r\n// \r\n}}\r\n\r\n// Closing popup after 9mins to make room for session extend popup. Used in uc_1_5_interval.\r\nfunction closePopUp() {\r\n    document.querySelector(\'#pers-modal_overlay\').style.display = \'none\';\r\n    \r\n    document.querySelector(\'#pers-modal_overlay\').style.animationName = "fade-out";\r\n}\r\n\r\nfunction translateContent(language) {\r\n    var button_text;\r\n    var paragraphText;\r\n    if (flag_booking === "1" && flag_search === "1") {\r\n        if (language === "en") {\r\n            paragraphText = "Just one step away from reaching your destination, complete your payment now!"\r\n        }\r\n        if (language === "ar") {\r\n            paragraphText = "خطوة واحدة فقط تفصلك عن الوصول إلى وجهتك، أتمم الدفع الآن!"\r\n        }\r\n    } else if (flag_booking === "0" && flag_search === "1") {\r\n        if (language === "en") {\r\n            paragraphText = "Your booking is not yet confirmed, please finish the payment process"\r\n        }\r\n        if (language === "ar") {\r\n            paragraphText = "حجزك لم يتم تأكيده بعد، يرجى إكمال عملية الدفع."\r\n        }\r\n    } else if (flag_booking === "0" && flag_search === "0") {\r\n        if (language === "en") {\r\n            paragraphText = "Don’t miss out, you’re so close. Finish the payment process now"\r\n        }\r\n        if (language === "ar") {\r\n            paragraphText = "أنت على وشك إتمام الحجز، لاتفوت الفرصة وأكمل عملية الدفع الآن."\r\n        }\r\n    }\r\n\r\n\r\n    document.querySelector(".pers-modal_content p").innerText = paragraphText\r\n}\r\n\r\n\r\nwindow.addEventListener("mousemove", function () {\r\n    lastMouseMoveTime = Date.now();\r\n});\r\n\r\n\r\nvar uc_1_5_interval = setInterval(function () {\r\n    if (id_flag === 1) {\r\n        if (Date.now() - lastMouseMoveTime > timeDelay && window.location.href.includes("/booking/payment")) {\r\n        // if (Date.now() - lastMouseMoveTime > timeDelay && window.location.href.includes("/booking")) {\r\n            popup()\r\n            id_flag = 0;\r\n            clearInterval(uc_1_5_interval)\r\n            setTimeout(function () {\r\n                closePopUp()\r\n            }, 540000);\r\n        }\r\n\r\n    }\r\n\r\n\r\n}, 100);'}}],notificationEnabled:!1},{ref:"9283049d-8156-433f-8279-e98b3c6edce4",name:"UC1.5a v1.3 Dwell time Selection page - PC-516 Text change",revision:16,archived:!1,target:{script:"(function () {\n    //for test\n//   targetingPassed();\n \n    var targeting_flag = 1;\n\tvar page_margin_interval  = setInterval(function() {\n  \ttry{\n      \tif(targeting_flag == 1){\n        \tif (window.location.href.includes(\"booking/flights\")){\n        \t    clearInterval(page_margin_interval);\n                targetingPassed();\n        \t}\n        \telse{\n        \t    throw 'Targeting not found';\n        \t}\n      \t}\n     \ttargeting_flag = 0;\n     \tclearInterval(page_margin_interval);\n  \t}  \n  \tcatch{}\n\t}, 500);\n\t\n    \n})()",targetPages:[]},traffic:{type:"advancedTraffic",allocationLow:1,allocationHigh:120,splits:[{ref:"26d0b4c0-7711-43ac-923e-b39a35be57d1",lowSplit:1,highSplit:108},{ref:"81012363-3d97-4d58-bd41-c59a12c2c679",lowSplit:109,highSplit:120}],coupled:!1},variants:[{ref:"26d0b4c0-7711-43ac-923e-b39a35be57d1",name:"Original",assets:{css:"/** style your Experience with CSS */",html:"\x3c!-- define the structure and content of your Experience in HTML e.g.--\x3e\n{{!--<div>My Content</div>--}}\n\x3c!-- Use dynamic Guest variables, type ctrl+space or guest to explore available entities.--\x3e\n\x3c!-- Type 'd' to see decisioning helpers --\x3e\n",js:'// You can choose how you want to add your HTML by using insertHTMLBefore, insertHTMLAfter, or replaceHTML methods\n// e.g insertHTMLAfter(\'.someClassName\'); or insertHTMLAfter(\'body\'); or replaceHTML(\'#myPageId\')\n\n(function () {\n\n//console.log("start");\nlet lastMouseMoveTime \n\nlet id_flag = 1\n// Setting time    \nvar timeDelay = 45 * 1000\n\n// Sending event each time variant triggers for KPIs\nfunction sendGoalEvent() {\n    //console.log("IN_TIMEOUT");\n    const eventData2 = {\n        channel: "WEB",\n        currency: "EUR",\n        pointOfSale: Engage.settings.pointOfSale,\n        language: "EN",\n        page: location.pathname\n    };\n\n    engage.event("UC_1_5_A_TRIGGER_CONTROL", eventData2);\n}\n\nsendGoalEvent()\n  \n// Sending event after 45s of inactivity for KPIs\nfunction sendTimedoutGoalEvent() {\n    //console.log("IN_TIMEOUT");\n    const eventData2 = {\n        channel: "WEB",\n        currency: "EUR",\n        pointOfSale: Engage.settings.pointOfSale,\n        language: "EN",\n        page: location.pathname\n    };\n\n\n\n    engage.event("UC_1_5_A_USER_TIMED_OUT_CONTROL", eventData2);\n}\n\nwindow.addEventListener("mousemove", function () {\n     lastMouseMoveTime = Date.now()\n});\n\nfunction startCountDown() {\n    //console.log("IN_COUNTDOWN");\n    // alert("startCountDown")\n    var uc_1_5_interval = setInterval(function () {\n        if (id_flag === 1) {\n            //console.log("IF 1");\n            var calc = Date.now() - lastMouseMoveTime;\n            if (calc > timeDelay && window.location.href.includes("booking/flights")) {\n                //console.log("IF 2");\n                sendTimedoutGoalEvent()\n                id_flag = 0;\n                clearInterval(uc_1_5_interval)\n            }\n\n        }\n\n\n    }, 100);\n}\n  \nstartCountDown();\n//console.log("END");\n  \n})();'}},{ref:"81012363-3d97-4d58-bd41-c59a12c2c679",name:"Variant 1 - Popup takeover 45s",assets:{css:"/*\r\n#fff\r\n\r\nGothamRounded-Book;\r\n#4D4D4D\r\n36\r\n#4D4D4D\r\n16\r\n#fff\r\n#000000\r\n#9e9e9e\r\n#fff\r\n16\r\n*/\r\n\r\n@font-face {\r\n    font-family: 'flynas-Bold';\r\n    src: url('./fonts/Flynas-Bold.eot');\r\n    src: url('./fonts/Flynas-Bold.eot?#iefix') format('embedded-opentype'), url('./fonts/Flynas-Bold.woff2') format('woff2'), url('./fonts/Flynas-Bold.woff') format('woff'), url('./fonts/Flynas-Bold.ttf') format('truetype'), url('./fonts/Flynas-Bold.svg#Flynas-Bold') format('svg');\r\n    font-weight: bold;\r\n    font-style: normal;\r\n    font-display: swap;\r\n}\r\n\r\n@font-face {\r\nfont-family: 'flynas-Thin';\r\nsrc: url('./fonts/Flynas-Thin.eot');\r\nsrc: url('./fonts/Flynas-Thin.eot?#iefix') format('embedded-opentype'), url('./fonts/Flynas-Thin.woff2') format('woff2'), url('./fonts/Flynas-Thin.woff') format('woff'), url('./fonts/Flynas-Thin.ttf') format('truetype'), url('./fonts/Flynas-Thin.svg#Flynas-Thin') format('svg');\r\nfont-weight: 100;\r\nfont-style: normal;\r\nfont-display: swap;\r\n}\r\n\r\n@font-face {\r\nfont-family: 'flynas-Light';\r\nsrc: url('./fonts/Flynas-Light.eot');\r\nsrc: url('./fonts/Flynas-Light.eot?#iefix') format('embedded-opentype'), url('./fonts/Flynas-Light.woff2') format('woff2'), url('./fonts/Flynas-Light.woff') format('woff'), url('./fonts/Flynas-Light.ttf') format('truetype'), url('./fonts/Flynas-Light.svg#Flynas-Light') format('svg');\r\nfont-weight: 300;\r\nfont-style: normal;\r\nfont-display: swap;\r\n}\r\n\r\n@font-face {\r\nfont-family: 'flynas-Regular';\r\nsrc: url('./fonts/Flynas-Regular.eot');\r\nsrc: url('./fonts/Flynas-Regular.eot?#iefix') format('embedded-opentype'), url('./fonts/Flynas-Regular.woff2') format('woff2'), url('./fonts/Flynas-Regular.woff') format('woff'), url('./fonts/Flynas-Regular.ttf') format('truetype'), url('./fonts/Flynas-Regular.svg#Flynas-Regular') format('svg');\r\nfont-weight: normal;\r\nfont-style: normal;\r\nfont-display: swap;\r\n}\r\n\r\n@font-face {\r\nfont-family: 'flynas-Medium';\r\nsrc: url('./fonts/Flynas-Medium.eot');\r\nsrc: url('./fonts/Flynas-Medium.eot?#iefix') format('embedded-opentype'), url('./fonts/Flynas-Medium.woff2') format('woff2'), url('./fonts/Flynas-Medium.woff') format('woff'), url('./fonts/Flynas-Medium.ttf') format('truetype'), url('./fonts/Flynas-Medium.svg#Flynas-Medium') format('svg');\r\nfont-weight: 500;\r\nfont-style: normal;\r\nfont-display: swap;\r\n}\r\n\r\n@font-face {\r\nfont-family: 'flynas-SemiBold';\r\nsrc: url('./fonts/Flynas-SemiBold.eot');\r\nsrc: url('./fonts/Flynas-SemiBold.eot?#iefix') format('embedded-opentype'), url('./fonts/Flynas-SemiBold.woff2') format('woff2'), url('./fonts/Flynas-SemiBold.woff') format('woff'), url('./fonts/Flynas-SemiBold.ttf') format('truetype'), url('./fonts/Flynas-SemiBold.svg#Flynas-SemiBold') format('svg');\r\nfont-weight: 600;\r\nfont-style: normal;\r\nfont-display: swap;\r\n}\r\n\r\n@font-face {\r\nfont-family: 'Flynas-ExtraBold';\r\nsrc: url('./fonts/Flynas-ExtraBold.eot');\r\nsrc: url('./fonts/Flynas-ExtraBold.eot?#iefix') format('embedded-opentype'), url('./fonts/Flynas-ExtraBold.woff2') format('woff2'), url('./fonts/Flynas-ExtraBold.woff') format('woff'), url('Flynas-ExtraBold.ttf') format('truetype'), url('./fonts/Flynas-ExtraBold.svg#Flynas-ExtraBold') format('svg');\r\nfont-weight: bold;\r\nfont-style: normal;\r\nfont-display: swap;\r\n}\r\n\r\n.UC_grid{\r\ndisplay:grid;\r\ngrid: 130px / 34% 62% 20px;\r\nmargin-top: 21%;\r\n}\r\n.arabic .pers-modal_content {\r\ntransform: scaleX(-1);\r\n}\r\n\r\n.arabic .UC_grid {\r\ntransform: scaleX(-1);\r\n}\r\n\r\n#pers-{{ref}} a,\r\n#pers-{{ref}} p,\r\n#pers-{{ref}} span,\r\n#pers-{{ref}} h3 {\r\nfont-family: flynas-Regular;\r\nfont-weight: 400;\r\nline-height: 1.2;\r\n}\r\n\r\n/*#pers-{{ref}} #pers-modal_overlay {*/\r\n/*  display: none;*/\r\n/*  justify-content: center;*/\r\n/*  align-items: center;*/\r\n/*  position: fixed;*/\r\n/*  z-index: 999999;*/\r\n/*  left: 0;*/\r\n/*  top: 0;*/\r\n/*  width: 100%;*/\r\n/*  height: 100%;*/\r\n/*  overflow: hidden;*/\r\n/*  background-color: rgba(0,0,0,0.4);*/\r\n/*  font-family: flynas-Regular;*/\r\n/*}*/\r\n#pers-{{ref}} #pers-modal_overlay {\r\ndisplay: none;\r\n\r\n/*PC-174*/\r\nanimation-duration: 0.5s;\r\nopacity: 1;\r\nanimation-name: fade-in;\r\nanimation-play-state: paused;\r\nanimation-fill-mode: forwards;\r\n\r\njustify-content: center;\r\nalign-items: center;\r\nposition: fixed;\r\nz-index: 999999;\r\nleft: 0;\r\ntop: 0;\r\nwidth: 100%;\r\nheight: 100%;\r\noverflow: hidden;\r\nbackground-color: rgba(0,0,0,0.4);\r\nfont-family: flynas-Regular;\r\n}\r\n\r\n/*PC-174*/\r\n@keyframes fade-in{\r\n0%   {\r\nopacity: 0;\r\n}\r\n100%   {\r\nopacity: 1;\r\n\r\n}\r\n}\r\n/*PC-174*/\r\n@keyframes fade-out{\r\n0%   {\r\nopacity: 1;\r\n}\r\n100%   {\r\nopacity: 0;\r\n\r\n}\r\n}\r\n\r\n#pers-{{ref}} #pers-modal_overlay .pers-modal_content {\r\ndisplay: flex;\r\nflex-direction: column;\r\nposition:relative;\r\nbackground: #fff;\r\nmargin: 0 auto;\r\nborder-radius: 4px;\r\n/*box-shadow: 0 2px 10px 6px rgba(0,0,0,0.3);*/\r\nwidth: 650px;\r\nmin-height: 325px;\r\nborder: none;\r\npadding: 20px 38px;\r\nbackground: url(https://static.flynas.com/images/HostedLinks/Pop-Ups/Pop-Ups/45-Secs.png);\r\nbackground-repeat: no-repeat;\r\nbackground-size: 100%;\r\n}\r\n\r\n#pers-{{ref}} #pers-modal_overlay .pers-modal_content h3 {\r\npadding: 12px 50px 12px 50px;\r\nline-height: 1.5;\r\nfont-size: 36;\r\nfont-weight: bold;\r\nmargin: auto;\r\ncolor: #4D4D4D;\r\nfont-family: flynas-Regular;\r\ntext-align: center;\r\n}\r\n\r\n#pers-{{ref}} #pers-modal_overlay .pers-modal_content p {\r\nmargin: 0;\r\npadding-top:25px;\r\nfont-size: 16px;\r\nfont-weight: bold;\r\nline-height: 28px;\r\ncolor: white;\r\nfont-family: flynas-Regular;\r\ntext-align: center;\r\n}\r\n\r\n#pers-{{ref}} #pers-modal_overlay .pers-modal_button-wrapper {\r\ndisplay: flex;\r\nmargin-top: auto;\r\nmargin: auto;\r\n}\r\n\r\n#pers-{{ref}} #pers-modal_overlay .pers-modal_button {\r\ndisplay: inline-block;\r\nborder-radius: 4px;\r\ntext-decoration: none;\r\ncolor: #fff;\r\nbackground-color: #000000;\r\npadding: 12px 53px;\r\nfont-size: 18px;\r\nfont-weight: bold;\r\n}\r\n\r\n#pers-{{ref}} #pers-modal_overlay .pers-modal_button:hover {\r\ncolor: #fff;\r\nbackground-color: #9e9e9e;\r\n}\r\n\r\n#pers-{{ref}} #pers-modal_overlay .pers-modal_dismiss-wrapper {\r\ndisplay: flex;\r\nmargin-top: auto;\r\nmargin: auto;\r\nmargin-left :25px;\r\n}\r\n\r\n#pers-{{ref}} #pers-modal_overlay .pers-modal_dismiss {\r\ndisplay: inline-block;\r\nborder-radius: 4px;\r\nmargin-left :25px;\r\ncolor: #fff;\r\npadding: 10px 23px;\r\n}\r\n\r\n/* close button */\r\n#pers-{{ref}} .pers-modal__btn-close-icon {\r\nbackground: transparent;\r\ntop: -60px;\r\nright: -15px;\r\nwidth: 7px;\r\nheight: 2px;\r\nposition: relative;\r\ncursor: pointer;\r\n}\r\n\r\n\r\n#pers-{{ref}} .pers-modal__btn-close-icon:after {\r\nbackground: transparent;\r\ncontent: \"\";\r\nheight: 20px;\r\nborder-left: 3px solid #df0f48;\r\nposition: absolute;\r\nmargin: auto;\r\ntransform: rotate(45deg);\r\n}\r\n\r\n#pers-{{ref}} .pers-modal__btn-close-icon:before {\r\nbackground: transparent;\r\ncontent: \"\";\r\nheight: 20px;\r\nborder-left: 3px solid #df0f48;\r\nmargin: auto;\r\nposition: absolute;\r\ntransform: rotate(-45deg);\r\n}\r\n\r\n@media only screen and (max-width: 600px)  {\r\n\r\n#pers-{{ref}} #pers-modal_overlay .pers-modal_content p {\r\npadding-top: 10px !important;\r\n}\r\n}\r\n@media only screen and (max-width: 500px)  {\r\n\r\n#pers-{{ref}} #pers-modal_overlay .pers-modal_content p {\r\npadding-top: 0px !important;\r\nfont-size: 11px !important;\r\npadding-left: 0px !important;\r\nline-height: 23px;\r\n}\r\n}\r\n@media only screen and (max-width: 410px)  {\r\n\r\n#pers-{{ref}} #pers-modal_overlay .pers-modal_content p {\r\npadding-top: 5px !important;\r\n}\r\n}\r\n@media only screen and (max-width: 380px)  {\r\n\r\n#pers-{{ref}} #pers-modal_overlay .pers-modal_content p {\r\n\r\nfont-size: 10px !important;\r\n\r\n}\r\n}\r\n",html:'\x3c!-- Use dynamic Guest variables, type ctrl+space or guest to explore available entities.--\x3e\n\x3c!-- Type "d" to see decisioning helpers --\x3e\n<div id="pers-modal_overlay">\n  <div class="pers-modal_content">\n   <div class="UC_grid">\n       <div></div>\n       <p>\n      Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat.\n    </p>\n    <div class="pers-modal__btn-close-icon"></div>\n   </div>\n    \n    \n  </div>\n</div>',js:'// ?bxQATool=true&bxFlowRef=bfb28eb4-af01-4d9e-8cde-49edd2836c7e&bxVariantRef=c2da6a36-7a89-4067-a759-97535de5db34&bxGuestRef=4f264a00-8d24-4dcf-94ee-46e023055c1f&bxGuestName=4f264a00-8d24-4dcf-94ee-46e023055c1f\r\nvar flag_booking = "{{flags.booking}}";\r\nvar flag_search = "{{flags.search}}";\r\nvar timeDelay = 45 * 1000\r\n\r\n//test values remove later \r\n// timeDelay = 1000;\r\n// flag_booking = "0";\r\n// flag_search = "1";\r\n//\r\n\r\n// Sending event each time variant triggers for KPIs\r\nfunction sendGoalEvent() {\r\n    //console.log("IN_TIMEOUT");\r\n    const eventData2 = {\r\n        channel: "WEB",\r\n        currency: "EUR",\r\n        pointOfSale: Engage.settings.pointOfSale,\r\n        language: "EN",\r\n        page: location.pathname\r\n    };\r\n\r\n    engage.event("UC_1_5_A_TRIGGER_VARIANT1", eventData2);\r\n}\r\n\r\nsendGoalEvent()\r\n\r\nvar id_flag = 1;\r\nlet id_flag2 = 1\r\nvar lastMouseMoveTime = Date.now();\r\n// Adds a unique variant identifier to CSS when deployed to ensure CSS does not impact styling of other elements.\r\nconsole.log("___UC_START___")\r\nvar compiledCSS = Engage.templating.compile(variant.assets.css)(variant);\r\nvar styleTag = document.getElementById(\'style-\' + variant.ref);\r\nif (styleTag) {\r\n    styleTag.innerHTML = compiledCSS;\r\n}\r\nvar supportedLangs = [\'ar\', \'en\']\r\n// End Adds a unique variant identifier to CSS when deployed to ensure CSS does not impact styling of other elements.\r\n\r\n\r\nfunction sendTimedoutGoalEvent() {\r\n    const eventData2 = {\r\n        channel: "WEB",\r\n        currency: "EUR",\r\n        pointOfSale: Engage.settings.pointOfSale,\r\n        language: "EN",\r\n        page: location.pathname\r\n    };\r\n\r\n\r\n\r\n    engage.event("UC_1_5_A_USER_TIMED_OUT", eventData2);\r\n}\r\n\r\n\r\n// make space in the body for the experience\r\n/*PC-174*/\r\nfunction popup() {\r\n    var lang = document.documentElement.lang.toLowerCase()\r\n    if (supportedLangs.includes(lang)) {\r\n        console.log("____POPUP____")\r\n        insertHTMLBefore(\'body\', \'pers-\');\r\n        sendTimedoutGoalEvent()\r\n\r\n        translateContent(lang)\r\n        document.querySelector(\'#pers-modal_overlay\').style.display = \'flex\';\r\n        document.querySelector(\'#pers-modal_overlay\').style.animationPlayState = "running";\r\n\r\n        document.body.classList.add(\'pers-modal_content\');\r\n        var persCardClose = document.querySelector(\'.pers-modal__btn-close-icon\');\r\n        // persCardClose.onclick = function () {\r\n        //     setTimeout(function () {\r\n        //         document.querySelector(\'#pers-modal_overlay\').style.display = \'none\';\r\n        //     }, 500);\r\n        //     document.querySelector(\'#pers-modal_overlay\').style.animationName = "fade-out";\r\n\r\n        // };\r\n        \r\n        // Fixing X(close button) on AR lang version\r\n        if (lang === "ar"){\r\n            persCardClose.style.right = "15px"\r\n        }\r\n        \r\n        // Aligning text on Firefox & Chrome\r\n        const userAgent = navigator.userAgent;\r\n        \r\n        if ((userAgent.indexOf("Firefox") !== -1) && lang === "ar") {\r\n            document.querySelector(".UC_grid p").style.paddingLeft = "20px"\r\n        } else if ((userAgent.indexOf("Firefox") !== -1) && lang === "en"){\r\n            document.querySelector(".UC_grid p").style.paddingRight = "30px"\r\n        } else if ((userAgent.indexOf("Chrome") !== -1) && lang === "ar") {\r\n            document.querySelector(".UC_grid p").style.paddingLeft = "30px"\r\n        }\r\n        \r\n        persCardClose.addEventListener(\'click\', function() {\r\n            setTimeout(function () {\r\n            document.querySelector(\'#pers-modal_overlay\').style.display = \'none\';\r\n            }, 500);\r\n\r\n            document.querySelector(\'#pers-modal_overlay\').style.animationName = "fade-out";\r\n        });\r\n    \r\n// UC1.5a & b closing popup usability fixes\r\n    document.addEventListener(\'click\', function(event) {\r\n      if(!document.querySelector("#pers-modal_overlay > div > div").contains(event.target))\r\n        setTimeout(function () {\r\n            document.querySelector(\'#pers-modal_overlay\').style.display = \'none\';\r\n        }, 500);\r\n\r\n        document.querySelector(\'#pers-modal_overlay\').style.animationName = "fade-out";\r\n    });\r\n// \r\n}}\r\n\r\n// Closing popup after 9mins to make room for session extend popup. Used in startCountDown.\r\nfunction closePopUp() {\r\n    setTimeout(function () {\r\n    document.querySelector(\'#pers-modal_overlay\').style.display = \'none\';\r\n        }, 500);\r\n    \r\n    document.querySelector(\'#pers-modal_overlay\').style.animationName = "fade-out";\r\n}\r\n\r\nfunction translateContent(language) {\r\n    var button_text;\r\n    var paragraphText;\r\n    if (flag_booking === "1" && flag_search === "1") {\r\n        if (language === "en") {\r\n            paragraphText = "We look forward to welcoming you onboard soon, book our lowest fares today!"\r\n        }\r\n        if (language === "ar") {\r\n            paragraphText = "يسعدنا استقبالكم على متن طائرتنا. احجز الآن لتحظى بأفضل الأسعار المتاحة اليوم!"\r\n        }\r\n    } else if (flag_booking === "0" && flag_search === "1") {\r\n        if (language === "en") {\r\n            paragraphText = "Don\'t just search, make it happen! Your trip awaits!"\r\n        }\r\n        if (language === "ar") {\r\n            paragraphText = "لا تتردد، وسافر على متن أفضل طيران اقتصادي في الشرق الاوسط لا تتردد بالبحث، رحلتك بانتظارك!"        \r\n            \r\n        }\r\n    } else if (flag_booking === "0" && flag_search === "0") {\r\n        if (language === "en") {\r\n            paragraphText = "Only a few seats are available, hurry and book yours today!"\r\n        }\r\n        if (language === "ar") {\r\n            paragraphText = "لا تفوت فرصة الوصول الى وجهتك ، احجز الآن قبل أن تنفد المقاعد المتبقية"\r\n        }\r\n    }\r\n\r\n\r\n    document.querySelector(".pers-modal_content p").innerText = paragraphText\r\n}\r\n\r\nwindow.addEventListener("mousemove", function () {\r\n    lastMouseMoveTime = Date.now()\r\n});\r\n\r\nfunction startCountDown() {\r\n    // alert("startCountDown")\r\n    var uc_1_5_interval = setInterval(function () {\r\n        if (id_flag === 1) {\r\n            var calc = Date.now() - lastMouseMoveTime;\r\n            if (calc > timeDelay && window.location.href.includes("booking/flights")) {\r\n                popup()\r\n                id_flag = 0;\r\n                clearInterval(uc_1_5_interval)\r\n            }\r\n\r\n        }\r\n\r\n\r\n    }, 100);\r\n}\r\n// alert("BEFORE uc_1_5_searchInterval")\r\nvar uc_1_5_searchInterval = setInterval(function () {\r\n    // alert("IN uc_1_5_searchInterval")\r\n    if (id_flag2 === 1) {\r\n        // alert("id_flag2: "+id_flag2)\r\n        let selectflightbtn = document.querySelector(".selectflightbtn")\r\n        if (selectflightbtn != null) {\r\n            // alert("uc_1_5_searchInterval")\r\n            id_flag2 = 0;\r\n            startCountDown()\r\n            clearInterval(uc_1_5_searchInterval)\r\n            setTimeout(function () {\r\n                closePopUp()\r\n            }, 390000);\r\n        }\r\n    }\r\n}, 400);'}}],notificationEnabled:!1},{ref:"736f09b2-343e-4456-8b86-2baa61f4cd7a",name:"UC 1.4 1st Booked Flight",revision:20,archived:!1,target:{script:"// Use client-side JavaScript to more specifically target users\n// NOTE: When your targeting conditions are met you must call targetingPassed() \n\n(function () {\n    console.log(\"pathname \"+window.location.pathname);\n    let onBookingPage = false\n    if(window.location.host.includes(\"booking\")) {\n        onBookingPage = true\n    }\n    \n    if(window.location.pathname === '' || (window.location.pathname === '/' && onBookingPage == false) || window.location.pathname.includes(\"home\") \n    || window.location.pathname === '/en' || window.location.pathname === '/ar'){\n        if(!window.location.pathname.includes(\"ru\"))\n            targetingPassed();    \n    }\n    \n})();",targetPages:[]},traffic:{type:"advancedTraffic",allocationLow:1,allocationHigh:120,splits:[{ref:"039ef706-d8c4-4378-9f10-d71f4da41dfe",lowSplit:1,highSplit:6},{ref:"5819a486-9f06-4a1f-ba96-80b5e08f5849",lowSplit:7,highSplit:120}],coupled:!1},variants:[{ref:"039ef706-d8c4-4378-9f10-d71f4da41dfe",name:"Original",assets:{css:"/** style your Experience with CSS */",html:"\x3c!-- define the structure and content of your Experience in HTML e.g.--\x3e\n<div>My Content</div>\n\x3c!-- Use dynamic Guest variables, type ctrl+space or guest to explore available entities.--\x3e\n\x3c!-- Type 'd' to see decisioning helpers --\x3e\n",js:"// You can choose how you want to add your HTML by using insertHTMLBefore, insertHTMLAfter, or replaceHTML methods\n// e.g insertHTMLAfter('.someClassName'); or insertHTMLAfter('body'); or replaceHTML('#myPageId')\n\n/*\n\n(function () {\n  // Add statements here\n})();\n\n*/"}},{ref:"5819a486-9f06-4a1f-ba96-80b5e08f5849",name:"Variant 1",assets:{css:"#newDiv{\r\n    height : 500px;\r\n    overflow : hidden;\r\n    width : 100%;\r\n    margin-bottom : -70px;\r\n    margin-left: auto;\r\n    margin-right: auto;\r\n    max-width: 1200px;\r\n}",html:"\x3c!-- define the structure and content of your Experience in HTML e.g.--\x3e\n<div>My Content</div>\n\x3c!-- Use dynamic Guest variables, type ctrl+space or guest to explore available entities.--\x3e\n\x3c!-- Type 'd' to see decisioning helpers --\x3e\n",js:'(function () {\r\n\r\n    let lang;\r\n    if(document.body.classList.contains("arabic")){\r\n        lang = "ar";\r\n    }\r\n    else{\r\n        lang = "en";\r\n    }\r\n    let parentElement = document.querySelector(".swiper-form-wrap");\r\n    let htmlVerios = "bag";\r\n\r\n    let text;\r\n    switch (lang) {\r\n        case "en":\r\n            text = [\r\n                "Don\'t forget to add your baggage now",\r\n                "Get the best seat in the house",\r\n                "Don\'t go hungry, order now to aviod disappointment"]\r\n\r\n\r\n            break;\r\n        case "ar":\r\n            text = [\r\n                "لا تنسَ إضافة أمتعتك الآن",\r\n                "احصل على أفضل مقعد في المكان",\r\n                "استمتع برحلتك بدون جوع، اطلب وجبتك الآن لضمان الاسترخاء"]\r\n            break;\r\n    }\r\n\r\n    const clone = document.querySelector("body > div.page > main > div.section.section-sm").cloneNode(true);\r\n    document.querySelector("body > div.page > main > div.section.section-sm").remove()\r\n    clone.querySelectorAll(".text-spacing-sm")[0].innerText = text[0];\r\n    clone.querySelectorAll(".text-spacing-sm")[1].innerText = text[2];\r\n    clone.querySelectorAll(".text-spacing-sm")[2].innerText = text[1];\r\n    document.querySelector("body > div.page > main").insertBefore(clone, document.querySelector("body > div.page > main > section.section.section-sm"));\r\n\r\n    let buttons = document.querySelector("body > div.page > main > div.section.section-sm").querySelectorAll(".box-minimal a");\r\n    buttons[0].addEventListener("click", onBtnClick);\r\n    buttons[1].addEventListener("click", onBtnClick);\r\n    buttons[2].addEventListener("click", onBtnClick);\r\n\r\n    function onBtnClick() {\r\n        console.log("1_4_CLICK");\r\n        sendCustomEvent("1_4_CLICK");\r\n    }\r\n\r\n    function sendCustomEvent(type) {\r\n        const eventData2 = {\r\n            channel: "WEB",\r\n            currency: "EUR",\r\n            pointOfSale: Engage.settings.pointOfSale,\r\n            language: "EN",\r\n            page: location.pathname\r\n        };\r\n        engage.event(type, eventData2);\r\n    }\r\n})();'}}],notificationEnabled:!1},{ref:"6931fdcd-eae8-4953-9110-53a3b297f061",name:"UC1.7 Sticky tool bar",revision:28,archived:!1,target:{script:'// Use client-side JavaScript to more specifically target users\n// NOTE: When your targeting conditions are met you must call targetingPassed() \n\n(function () {\n    const pathnames = ["/", "/ar", "/en", "/en-ae", "/about-us", "/sustainability", "/contact-us", "/media-center/news-updates", "/help", "/en/weekend-sale", "/ar/weekend-sale", "/en/international-offer", "/ar/international-offer", "/en/aramcoltp", "/ar/aramcoltp"];\n    \n    const top_pages_pathnames = ["/", "/ar", "/en", "/en-ae", "/ar/weekend-sale", "/en/book-flight", "/ar/tiers-and-benefits", \n    "/en/weekend-sale", "/ar/plan-my-trip/seat-selection", "/en-eu/book-flight", "/ar/earn-nasmiles", \n    "/ar/help/online-checkin", "/en-eu/manage-booking", "/ar/book-flight", "/en/manage-booking", "/ar/manage-booking", \n    "/ar/plan-my-trip/baggage", "/en/help/online-checkin", "/ar/contact-us/faqs", "/en/plan-my-trip/baggage", "/ar/international-offer", \n    "/en/booking-flynas/fare-types", "/ar/redeem-smiles", "/ar/domestic-offer", \n    "/en/tiers-and-benefits", "/ar/booking-flynas/fare-types", "/en/media-center/news-updates", "/ar/evisa", "/en/international-offer", \n    "/ar/plan-my-trip/airports-terminals", "/ar/home", "/en/aramcoltp", "/ar/help", \n    "/en/help/flight-status", "/en/domestic-offer", "/ar/nasmiles-contact-us"];\n    \n    const pathname = window.location.pathname;\n    \n    if(window.location.host.includes("booking") || pathnames.includes(pathname)){\n        return;\n    }\n    \n    const partialPathnames = ["booking", "/about-us", "/sustainability", "/contact-us", "/media-center/news-updates", "/help", "/home"];\n    for(var id in partialPathnames){\n        if(pathname.includes(partialPathnames[id])){\n            return;\n        }\n    }\n    \n    if(top_pages_pathnames.includes(pathname)){\n        targetingPassed();\n    }\n\n})();',targetPages:[]},traffic:{type:"advancedTraffic",allocationLow:1,allocationHigh:120,splits:[{ref:"bf927119-4847-4352-9d33-de3bf463f67f",lowSplit:1,highSplit:6},{ref:"45ba9e50-a163-441a-a497-37de8b42b9f1",lowSplit:7,highSplit:120}],coupled:!1},variants:[{ref:"bf927119-4847-4352-9d33-de3bf463f67f",name:"Original",assets:{css:"/** style your Experience with CSS */",html:"\x3c!-- define the structure and content of your Experience in HTML e.g.--\x3e\n<div>My Content</div>\n\x3c!-- Use dynamic Guest variables, type ctrl+space or guest to explore available entities.--\x3e\n\x3c!-- Type 'd' to see decisioning helpers --\x3e\n",js:"// You can choose how you want to add your HTML by using insertHTMLBefore, insertHTMLAfter, or replaceHTML methods\n// e.g insertHTMLAfter('.someClassName'); or insertHTMLAfter('body'); or replaceHTML('#myPageId')\n\n/*\n\n(function () {\n  // Add statements here\n})();\n\n*/"}},{ref:"45ba9e50-a163-441a-a497-37de8b42b9f1",name:"Variant 1",assets:{css:"element.style {}\r\n\r\n.uc1_7_container .v1_C4818_J4210.template-home.stickyWidget:not(.showTabs) .search-widget {\r\n    max-height: 74px;\r\n}\r\n.uc1_7_container{\r\n    width: 950px;\r\n    margin-right: auto;\r\n    margin-left: auto;\r\n    padding-left: 15px;\r\n    padding-right: 15px;\r\n}\r\n\r\n.uc1_7-widget-status-icon\r\n{background-position: -155px -10px !important}\r\n\r\n.uc1_7_container .nav-link{\r\n    cursor: pointer;\r\n}\r\n.uc1_7_container .tab-content{\r\n    background-color: white;\r\n}\r\n\r\n.uc1_7_container .v1_C4818_J4210.template-home.stickyWidget .search-widget {\r\n    width: 100%;\r\n    left: 50%;\r\n    transform: translateX(-50%);\r\n    -webkit-transform: translateX(-50%);\r\n    -moz-transform: translateX(-50%);\r\n    top: 0;\r\n    right: auto;\r\n    max-width: 1200px;\r\n    position: fixed;\r\n}\r\n.uc1_7_container .widget-menu ul li a i{\r\n    position: relative;\r\n    left: 50%;\r\n    transform: translateX(-50%);\r\n    -webkit-transform: translateX(-50%);\r\n    -moz-transform: translateX(-50%);\r\n    transition: none;\r\n    background-size: 1000px !important;\r\n    height: 39px;\r\n    display: inline-block;\r\n    width: 32px;\r\n    background: url(/images/sprite-icons.svg);\r\n    \r\n}\r\n\r\n.uc1_7_container.ar .widget-menu ul li a i{\r\n    left: -30%;\r\n}\r\n.uc1_7_container.ar .widget-menu ul li a .widget-checkin-icon{\r\n    left: -25%;\r\n}\r\n.uc1_7_container .widget-menu ul li{\r\n    width: 20% !important;\r\n    border-left: 1px solid white;\r\n    \r\n}\r\n.uc1_7_container .widget-menu ul li:hover{\r\n\r\n    span {color: #e0396d;}\r\n}\r\n.uc1_7_container .nav-tabs{\r\n    --bs-nav-tabs-border-width: 0px;\r\n}\r\n.uc1_7_container .widget-menu ul li a{\r\n    text-decoration: none;\r\n}\r\n\r\n.uc1_7_container .widget-menu img{\r\n    height: 32px !important;\r\n    display: block;\r\n    text-align: center;\r\n    margin: 7px auto;\r\n}\r\n\r\n.uc1_7_container .widget-menu ul{\r\n    background-color: rgba(0, 183, 172, 1);\r\n    border-radius: var(--bs-border-radius-lg) !important;\r\n}\r\n.uc1_7_container .widget-menu ul li a span{\r\n    text-align: center;\r\n    line-height: 18px;\r\n    font-weight: bold;\r\n    font-size: 14px !important;\r\n    box-sizing: border-box;\r\n    color: white;\r\n    display: block;\r\n    transition: color .15s ease-in-out, background-color .15s ease-in-out, border-color .15s ease-in-out;\r\n}\r\n.uc1_7_container .widget-menu ul li:hover{\r\n    \r\n}\r\n.uc1_7_container .widget-menu ul li a.active span{\r\n    color: #00bfb3;\r\n}\r\n.uc1_7_container .widget-checkin-icon{\r\n    margin-bottom: 7px;\r\n\r\n}\r\n\r\n.uc1_7_container .search-widget {\r\n    position: relative;\r\n    z-index: 1000;\r\n}\r\n\r\n.uc1_7_container .rounded-3 {\r\n    border-radius: var(--bs-border-radius-lg) !important;\r\n}\r\n\r\n.uc1_7_container .shadow-lg {\r\n    box-shadow: 0 1rem 3rem rgba(0, 0, 0, .175) !important;\r\n}\r\n\r\n@media (min-width: 992px) {\r\n    body {\r\n        line-height: 1.42857143 !important;\r\n    }\r\n}\r\n\r\n@media screen and (max-width: 1199px) {\r\n    .uc1_7_container{\r\n        position: fixed;\r\n        width: 100%;\r\n        /* bottom: -26px; */\r\n        top: 78px;\r\n        z-index: 99;\r\n    }\r\n    \r\n    .uc1_7_container.ar .widget-menu ul li a i{\r\n        left: -33%;\r\n    }\r\n}\r\n\r\n\r\n@media screen and (max-width: 992px) {\r\n    .uc1_7_container{\r\n        width: 100%;\r\n        bottom: 0px;\r\n        top: auto;\r\n        z-index: 999999;\r\n        padding-left: 0px;\r\n        padding-right: 0px;\r\n    }\r\n    .uc1_7_container .nav-link{\r\n        padding: 1px 1px 6px 1px;\r\n    }\r\n}\r\n\r\n@media screen and (max-width: 860px) {\r\n        .uc1_7_container.ar .widget-menu ul li a i{\r\n        left: -32%;\r\n    }\r\n}\r\n@media screen and (max-width: 860px) {\r\n        .uc1_7_container.ar .widget-menu ul li a i{\r\n        left: -32%;\r\n    }\r\n}\r\n@media screen and (max-width: 620px) {\r\n        .uc1_7_container.ar .widget-menu ul li a i{\r\n        left: -24%;\r\n    }\r\n}\r\n@media screen and (max-width: 470px) {\r\n        .uc1_7_container.ar .widget-menu ul li a i{\r\n        left: -18%;\r\n    }\r\n    .uc1_7_container.ar .widget-menu ul li a .widget-checkin-icon {\r\n        left: -2%;\r\n    }\r\n}\r\n@media screen and (max-width: 380px) {\r\n        .uc1_7_container.ar .widget-menu ul li a i{\r\n        left: -8%;\r\n    }\r\n    .uc1_7_container.ar .widget-menu ul li a .widget-checkin-icon {\r\n        left: 3%;\r\n    }\r\n}",html:'\x3c!-- define the structure and content of your Experience in HTML e.g.--\x3e\n{{!--<div>My Content</div>--}}\n\x3c!-- Use dynamic Guest variables, type ctrl+space or guest to explore available entities.--\x3e\n\x3c!-- Type \'d\' to see decisioning helpers --\x3e\n\n<script src="/sb/flight-search-js.js.v7de777cefc3f9aa96b4646d8800bd066d8120262"><\/script>\n<div class="uc1_7_container">\n    <div class="tab-container shadow-lg rounded-3 search-widget">\n    <div class="widget-menu">\n        <ul class="nav nav-tabs" id="main-tab" role="tablist">\n            <li class="nav-item" role="presentation"> <a class="nav-link " \n                     aria-selected="true" role="tab"> \n                     \n                    <i class="widget-flight-icon"></i>\n                    <span >Flights</span>\n\n                    </a> </li>\n                    \n            {{!--<li class="nav-item " role="presentation"> <a class="nav-link flight-hotel-tab"--}}\n            <li class="nav-item " role="presentation"> <a class="nav-link"\n                     aria-selected="false" tabindex="-1" role="tab">\n                    <i class="widget-flight-hotelicon"></i> \n                        <span>Flight + Hotel</span> \n                        \n\n                    \n                        </a> </li>\n            <li class="nav-item" role="presentation"> <a class="nav-link" \n                     aria-selected="false" tabindex="-1" role="tab"> \n                    <i class="widget-manage-icon"></i> \n                        <span>Manage</span> \n\n                        \n                        </a> </li>\n            <li class="nav-item" role="presentation"> <a class="nav-link" \n                     aria-selected="false" tabindex="-1" role="tab"> \n                    <i class="widget-checkin-icon"></i> \n                        <span>Check-in</span>\n                        \n\n                        </a> </li>\n            <li class="nav-item" role="presentation"> <a class="nav-link" \n                     aria-selected="false" tabindex="-1" role="tab"> \n                    <i class="uc1_7-widget-status-icon"></i> \n                    <span>Flight Status</span> \n                    \n\n                        </a> </li>\n            <li class="nav-item" id="rentCarListItem" role="presentation"> <a \n                    class="nav-link" \n                    aria-selected="false" tabindex="-1" role="tab"> \n                    <img src="https://useruploads.visualwebsiteoptimizer.com/useruploads/176372/images/41d876f274d39b69f491f169d71ad876_rentcar.png"\n                        alt=""> \n                        <span>Rent a car</span> \n                        \n                        </a> </li>\n        </ul>\n    </div>\n    \x3c!--<div class="tab-content">\n        <div class="tab-pane active" id="flights" role="tabpanel">\n            <form id="frmFlightSearch" class="needs-validation" novalidate="">\n                <div class="p-3 mobile-style">\n                    <div class="row-trip-type my-1 mx-3">\n                        <div class="row">\n                            <div class="col-md-6 round-trip-panel">\n                                <div class="form-check form-check-inline"> <input class="form-check-input radio-custom"\n                                        type="radio" name="trip-type" id="tripOneway" value="oneway"><span\n                                        class="radio-custom-dummy"></span> <label class="form-check-label"\n                                        for="tripOneway">One Way</label> </div>\n                                <div class="form-check form-check-inline"> <input class="form-check-input radio-custom"\n                                        type="radio" name="trip-type" id="tripTwoWay" value="round"\n                                        checked="checked"><span class="radio-custom-dummy"></span> <label\n                                        class="form-check-label" for="tripTwoWay">Round trip</label> </div>\n                                <div class="form-check form-check-inline"> <input class="form-check-input radio-custom"\n                                        type="radio" name="trip-type" id="tripMultiCity" value="multi"><span\n                                        class="radio-custom-dummy"></span> <label class="form-check-label"\n                                        for="tripMultiCity">Multi-City</label> </div>\n                            </div>\n                            <div class="col-md-2 p-2" style="display:none">\n                                <div class="form-check form-check-inline cb-stop-over-booking" style=""> <input\n                                        class="form-check-input ms-3 me-2 checkbox-custom" type="checkbox"\n                                        id="cbStopOver"><span class="checkbox-custom-dummy"></span> <label\n                                        class="form-check-label" for="cbStopOver">Stop Over</label> </div>\n                            </div>\n                        </div>\n                    </div>\n                    <div class="row my-1 mx-3 mb-0" id="onewayContent">\n                        <div class="col-md-12 mobile-only flight-number single-trip" style="display:none">Flight 1</div>\n                        <div class="col-md-7 pe-0">\n                            <div class="row position-relative station-panel">\n                                <div class="col-md-6 col-xs-12 origin-dropdown">\n                                    <div class="input-station"> <select\n                                            class="form-select station-dropdown select2-hidden-accessible"\n                                            id="fromStation" aria-label="From" required="" data-placeholder="Origin"\n                                            tabindex="-1" aria-hidden="true">\n                                            <option value="AHB">Abha</option>\n                                            <option value="AUH">Abu Dhabi</option>\n                                            <option value="ADD">Addis Ababa</option>\n                                            <option value="AJF">Al Jouf</option>\n                                            <option value="ULH">AlUla</option>\n                                            <option value="AMM">Amman</option>\n                                            <option value="BGW">Baghdad</option>\n                                            <option value="BAH">Bahrain</option>\n                                            <option value="GYD">Baku</option>\n                                            <option value="BER">Berlin</option>\n                                            <option value="FRU">Bishkek</option>\n                                            <option value="BRU">Brussels</option>\n                                            <option value="CAI">Cairo</option>\n                                            <option value="SPX">Cairo Sphinx Airport</option>\n                                            <option value="EG1">Cairo, All Airports</option>\n                                            <option value="COV">Cukurova Airport</option>\n                                            <option value="DMM">Dammam</option>\n                                  