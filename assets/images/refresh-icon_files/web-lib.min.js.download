, "وجهة لعشاق الثقافة", "وجهة للاسترخاء"];\n        options[3] = airportsTranslated[options[3]];\n        options[4] = airportsTranslated[options[4]];\n        options[5] = airportsTranslated[options[5]];\n    }\n\n    insertHTMLAfter(\'body\');\n\n    if (lang === "ar") {\n        document.querySelector("#test_uc_2_3_destination_promotions").classList.add("ar");\n\n    }\n\n    const content = document.querySelector("#test_uc_2_3_destination_promotions .uc_2_3_content");\n\n    let panel = content.querySelectorAll(".uc_2_3_panel.panel7");\n\n    content.querySelector(".uc_2_3_title").innerText = text[0];\n    content.querySelector(".uc_2_3_text").innerText = text[1];\n    console.log(options);\n    // panel[0].querySelector(".uc_2_3_panel_text p").innerText = options[3];\n    panel[0].querySelector(".uc_2_3_panel_text").innerHTML = `<p>${options[3]}</p>${text[2]}`;\n\n    if (imgs[optionsNotTransl[3]] !== undefined)\n        panel[0].querySelector(".uc_2_3_img").src = imgs[optionsNotTransl[3]]\n\n\n    panel[0].addEventListener("click", function() {\n        onBtnClick(optionsNotTransl[3])\n    });\n    \n    let isPanelRemoved = false;\n    \n    if (options[4] !== "" && options[4] !== undefined) {\n        \n        // panel[1].querySelector(".uc_2_3_panel_text p").innerText = options[4];\n        panel[1].querySelector(".uc_2_3_panel_text").innerHTML = `<p>${options[4]}</p>${text[3]}`;\n        if (imgs[optionsNotTransl[4]] !== undefined)\n            panel[1].querySelector(".uc_2_3_img").src = imgs[optionsNotTransl[4]]\n\n        panel[1].addEventListener("click", function() {\n            onBtnClick(optionsNotTransl[4])\n        });\n    } else {\n        isPanelRemoved = true;\n        panel[1].style.display = "none";\n        content.querySelectorAll(".uc_2_3_underline")[0].style.display = "none";\n    }\n\n    if (options[5] !== "" && options[5] !== undefined) {\n        // panel[2].querySelector(".uc_2_3_panel_text p").innerText = options[5];\n        panel[2].querySelector(".uc_2_3_panel_text").innerHTML = `<p>${options[5]}</p>${text[4]}`;\n        if (imgs[optionsNotTransl[5]] !== undefined)\n            panel[2].querySelector(".uc_2_3_img").src = imgs[optionsNotTransl[5]]\n\n        //     \n\n        panel[2].addEventListener("click", function() {\n            onBtnClick(optionsNotTransl[5])\n        });\n    } else {\n        isPanelRemoved = true;\n        panel[2].style.display = "none";\n        content.querySelectorAll(".uc_2_3_underline")[1].style.display = "none";\n    }\n    \n    if(isPanelRemoved && destination !== "EBB"){\n        content.classList.add("panelRemoved");\n        // panel[0].style.marginLeft = Math.floor((window.innerWidth - 580)/2)-30 +"px";\n        // addEventListener("resize", function(){\n        //     panel[0].style.marginLeft = Math.floor((window.innerWidth - 580)/2)-30 +"px";\n        // });\n    }\n    else if(isPanelRemoved && destination === "EBB"){\n        content.classList.add("onePanel");\n    }\n\n    content.querySelector(".uc_2_3_escape").addEventListener("click", function() {\n        document.querySelector("#test_uc_2_3_destination_promotions").classList.remove("open");\n    });\n\n    setTimeout(function() {\n        sendCustomEvent("2_3_SHOWN");\n        document.querySelector("#test_uc_2_3_destination_promotions").classList.add("open");\n    }, 500);\n\n    function onBtnClick(destination) {\n        console.log("onBtnClick destination " + destination);\n        sendCustomEvent("2_3_CLICK");\n        destination = destination.replace(" ", "-");\n        let newlang;\n        if (lang !== "ar") {\n            lang = "en";\n        }\n        setTimeout(function() {\n            window.location.href = `https://www.flynas.com/${lang}/flights-to-${destination}`;\n\n        }, 500);\n    }\n\n    function sendCustomEvent(type) {\n        const eventData2 = {\n            channel: "WEB",\n            currency: "EUR",\n            pointOfSale: Engage.settings.pointOfSale,\n            language: "EN",\n            page: location.pathname\n        };\n        engage.event(type, eventData2);\n    }\n\n    let uc_2_3_interval = setInterval(function() {\n        timer -= 500;\n        // console.log(timer);\n        if (timer < 0) {\n            document.querySelector("#test_uc_2_3_destination_promotions").classList.remove("open");\n            clearInterval(uc_2_3_interval);\n        }\n\n    }, 500);\n    if (timerOff) {\n        clearInterval(uc_2_3_interval);\n    }\n\n    document.addEventListener(\'click\', function(event) {\n        if (!document.querySelector("#test_uc_2_3_destination_promotions").contains(event.target)) {\n            document.querySelector("#test_uc_2_3_destination_promotions").classList.remove("open");\n            clearInterval(uc_2_3_interval);\n        } else {\n            timer = 10000;\n        }\n    });\n\n})();'}},{ref:"729db754-3c9e-474b-a7de-a1bdcd111dc9",name:"Original",assets:{css:"/** style your Experience with CSS */",html:"\x3c!-- define the structure and content of your Experience in HTML e.g.--\x3e\n<div>My Content</div>\n\x3c!-- Use dynamic Guest variables, type ctrl+space or guest to explore available entities.--\x3e\n\x3c!-- Type 'd' to see decisioning helpers --\x3e\n",js:"// You can choose how you want to add your HTML by using insertHTMLBefore, insertHTMLAfter, or replaceHTML methods\n// e.g insertHTMLAfter('.someClassName'); or insertHTMLAfter('body'); or replaceHTML('#myPageId')\n\n/*\n\n(function () {\n  // Add statements here\n})();\n\n*/"}}],notificationEnabled:!1},{ref:"2337abbd-3a3d-45e4-a7f3-ab5d8af31450",name:"1.1 Last Search v1.3 new rev goal",revision:47,archived:!1,target:{script:"// Use client-side JavaScript to more specifically target users\n// NOTE: When your targeting conditions are met you must call targetingPassed() \n\n(function () {\n    console.log(\"pathname \"+window.location.pathname);\n    let onBookingPage = false\n    if(window.location.host.includes(\"booking\")) {\n        onBookingPage = true\n    }\n    \n    if(window.location.pathname === '' || (window.location.pathname === '/' && onBookingPage == false) || window.location.pathname.includes(\"home\") \n    || window.location.pathname === '/en' || window.location.pathname === '/ar'){\n        if(!window.location.pathname.includes(\"ru\"))\n            targetingPassed();    \n    }\n    \n})();",targetPages:[]},traffic:{type:"advancedTraffic",allocationLow:1,allocationHigh:120,splits:[{ref:"82b05af2-3700-4a44-bd87-61ecadcbc12c",lowSplit:1,highSplit:6},{ref:"0933a91e-1a2d-4be0-975b-500e6a798d77",lowSplit:7,highSplit:120}],coupled:!1},variants:[{ref:"82b05af2-3700-4a44-bd87-61ecadcbc12c",name:"Original",assets:{css:"/** style your Experience with CSS */",html:"\x3c!-- define the structure and content of your Experience in HTML e.g.--\x3e\n<div>My Content</div>\n\x3c!-- Use dynamic Guest variables, type ctrl+space or guest to explore available entities.--\x3e\n\x3c!-- Type 'd' to see decisioning helpers --\x3e\n",js:"// You can choose how you want to add your HTML by using insertHTMLBefore, insertHTMLAfter, or replaceHTML methods\n// e.g insertHTMLAfter('.someClassName'); or insertHTMLAfter('body'); or replaceHTML('#myPageId')\n\n/*\n\n(function () {\n  // Add statements here\n})();\n\n*/"}},{ref:"0933a91e-1a2d-4be0-975b-500e6a798d77",name:"Variant 1",assets:{css:"/** style your Experience with CSS */\r\n\r\n@font-face {\r\n    font-family: 'GothamRounded-Bold';\r\n    src: url('./fonts/GothamRounded-Bold.eot?#iefix') format('embedded-opentype'), url('./fonts/GothamRounded-Bold.otf') format('opentype'), url('./fonts/GothamRounded-Bold.woff') format('woff'), url('./fonts/GothamRounded-Bold.ttf') format('truetype'), url('./fonts/GothamRounded-Bold.svg#GothamRounded-Bold') format('svg');\r\n    font-weight: normal;\r\n    font-style: normal;\r\n}\r\n\r\n\r\n@font-face {\r\n    font-family: 'GothamRounded-Book';\r\n    src: url('./fonts/GothamRounded-Book.eot?#iefix') for