laceholder="Enter Last Name"\n                            name="LastName" id="txtCheckInLastName" required="">\n                        <div class="invalid-tooltip"> Please enter Last Name. </div>\n                    </div>\n                    <div class="col-md-2 pt-3"> <button class="btn btn-primary rounded-2 btn-search"\n                            id="btnCheckInSearch" type="submit">Find Booking</button> </div>\n                </form>\n                <div class="row m-0 pt-3"> <span class="text-dark">Save valuable time, check-in for your flight</span>\n                </div>\n            </div>\n        </div>\n        <div class="tab-pane" id="flightStatus" role="tabpanel">\n            <div class="p-3">\n                <div class="row p-0 m-0 px-3 pt-4 pb-3 flight-status-tabs">\n                    <div class="col-md-2"> <label class="radio-label"> <input type="radio"\n                                class="form-check-input radio-input me-2 radio-custom" name="searchType" value="route"\n                                checked=""><span class="radio-custom-dummy"></span>Search by route </label> </div>\n                    <div class="col-md-3"> <label class="radio-label"> <input type="radio"\n                                class="form-check-input radio-input me-2 radio-custom" name="searchType"\n                                value="flightNumber" id="roundTripCheckBox"><span\n                                class="radio-custom-dummy"></span>Search by flight number </label> </div>\n                </div>\n                <form class="row p-0 m-0 px-3 needs-validation form-home-search-widget" novalidate="">\n                    <div class="col-md-7 pt-2" id="pnlFsRoute">\n                        <div class="row">\n                            <div class="col-md-6 position-relative">\n                                <div class="input-station"> <select class="form-select select2-hidden-accessible"\n                                        id="fsFromStation" ari