ow nudge",revision:76,archived:!1,target:{script:'// Use client-side JavaScript to more specifically target users\n// NOTE: When your targeting conditions are met you must call targetingPassed() \n\n(function() {\n\n\n    var targeting_flag = 1;\n    var page_margin_interval = setInterval(function() {\n        if (targeting_flag == 1) {\n            if (window.location.hash.includes("booking/extras")) {\n                clearInterval(page_margin_interval);\n                targetingPassed();\n            } else if (window.location.hash.includes("#/manage/extras")) {\n                clearInterval(page_margin_interval);\n                targetingPassed();\n            } else if (window.location.hash.includes("#/booking/extras") || window.location.hash.includes("#/wci/extras") || window.location.hash.includes("#/manage/booking") || window.location.hash.includes("/wci/flights")) {\n                clearInterval(page_margin_interval);\n                targetingPassed();\n            } else {\n                throw \'Targeting not found\';\n            }\n        }\n        targeting_flag = 0;\n        clearInterval(page_margin_interval);\n    }, 500);\n\n\n})()',targetPages:[]},traffic:{type:"advancedTraffic",allocationLow:1,allocationHigh:120,splits:[{ref:"27e08c02-e019-4106-92cb-32722474a010",lowSplit:1,highSplit:6},{ref:"2ec26b8f-624d-407a-a2a9-c571b8989865",lowSplit:7,highSplit:120}],coupled:!1},variants:[{ref:"27e08c02-e019-4106-92cb-32722474a010",name:"Original",assets:{css:"/** style your Experience with CSS */",html:"\x3c!-- define the structure and content of your Experience in HTML e.g.--\x3e\n<div>My Content</div>\n\x3c!-- Use dynamic Guest variables, type ctrl+space or guest to explore available entities.--\x3e\n\x3c!-- Type 'd' to see decisioning helpers --\x3e\n",js:"// You can choose how you want to add your HTML by using insertHTMLBefore, insertHTMLAfter, or replaceHTML methods\n// e.g insertHTMLAfter('.someClassName'); or insertHTMLAfter('body'); or replaceHTML('#myPageId')\n\n/*\n\n(function () {\n  // Add statements here\n})();\n\n*/"}},{ref:"2ec26b8f-624d-407a-a2a9-c571b8989865",name:"Variant 1",assets:{css:'/** style your Experience with CSS */\r\n\r\n/* Ensure that the row class has a clearfix */\r\n.row::after {\r\n    content: "";\r\n    display: table;\r\n    clear: both;\r\n}\r\n\r\n/* Example styles for the columns */\r\n.col-4 {\r\n    width: 33.33%;\r\n    float: left;\r\n}\r\n\r\n.col-6 {\r\n    width: 50%;\r\n    float: left;\r\n}\r\n\r\n.col-2 {\r\n    width: 16.67%;\r\n    float: left;\r\n    text-align: right;\r\n}\r\n\r\n/* Add margin to expand button to have more space between button and inserted text */\r\n.summary-open {\r\n    /* margin-right: 18px; */\r\n}\r\n\r\n.uc-18-sitecore {\r\n    width: 540px;\r\n    padding-left: 30px;\r\n}\r\n\r\n.uc-18-sitecore.ar_mmb {\r\n    width: 496px;\r\n}\r\n\r\n.uc-18-sitecore.booking {\r\n    width: 380px;\r\n}\r\n\r\n\r\n@media (width <= 1220px) {\r\n    .uc-18-sitecore.booking {\r\n        width: 300px;\r\n    }\r\n\r\n    .uc-18-sitecore.ar_mmb {\r\n    width: 490px;\r\n    }\r\n}\r\n\r\n@media (width <= 1125px) {\r\n    .uc-18-sitecore {\r\n        width: calc(100% - 700px);\r\n    }\r\n}\r\n\r\n@media (width <= 1035px) {\r\n    .uc-18-sitecore {\r\n        width: calc(100% - 650px);\r\n    }\r\n}\r\n\r\n\r\n@media (width <= 1180px) {\r\n    .uc-18-sitecore {\r\n        width: 30%;\r\n    }\r\n\r\n    .uc-18-sitecore.ar_mmb {\r\n        width: 100%;\r\n    }\r\n}\r\n\r\n/* .hide-mobile:first-child { */\r\n\r\n/*    width: calc(100% - 240px); */\r\n\r\n/* } */\r\n\r\n#main_con > app-booking-extras > div > div.fullwidth > div > app-summary > div.footer-wrapper.d-print-none.ng-star-inserted > div.container > div > div.col-2.text-end.uc18 {\r\n    position: relative;\r\n    float: right;\r\n    right: 0;\r\n}\r\n\r\n@media (width <= 1199px) {\r\n    #main_con > app-booking-extras > div > div.fullwidth > div > app-summary > div.footer-wrapper.d-print-none.ng-star-inserted > div.container > div > div.col-2.text-end.uc18 {\r\n        position: absolute;\r\n    }\r\n\r\n    #main_con > app-booking-extras > div > div.fullwidth > div > app-summary > div.footer-wrapper.d-print-none.ng-star-inserted > div.container > div > div.col-4.uc-18-sitecore.booking {\r\n        width: calc(100% - 650px) !important;\r\n    }\r\n}\r\n\r\n.sitecore-mobile-text {\r\n    width: 100%;\r\n    padding: 15px;\r\n    text-align: center;\r\n}\r\n\r\n@media (width <= 1130px) {\r\n    .uc-18-sitecore {\r\n        display: none;\r\n    }\r\n}\r\n@media (992px <= width <= 1130px) {\r\n    #main_con > app-booking-extras > div > div.fullwidth > div > app-summary > div.footer-wrapper.d-print-none.pdf-print > div.container > div > div.col-2.text-end.uc18 { \r\n        padding-left: 315px;\r\n    }\r\n}\r\n/*@media (width <= 992px) and (width <= 768px) {*/\r\n/*    #main_con > app-booking-extras > div > div.fullwidth > div > app-summary > div.footer-wrapper.d-print-none.pdf-print > div.container > div > div.col-2.text-end.uc18 { */\r\n/*        padding-left: 195px;*/\r\n/*    }*/\r\n/*}*/\r\n@media (768px <= width <= 992px) {\r\n    #main_con > app-booking-extras > div > div.fullwidth > div > app-summary > div.footer-wrapper.d-print-none.pdf-print > div.container > div > div.col-2.text-end.uc18 { \r\n        padding-left: 195px;\r\n    }\r\n}\r\n@media (757px <= width <= 767px) {\r\n    #main_con > app-booking-extras > div > div.fullwidth > div > app-summary > div.footer-wrapper.d-print-none.pdf-print > div.container > div > div.col-2.text-end.uc18 { \r\n        padding-left: 9px;\r\n    }\r\n}\r\n@media (width <= 756px) {\r\n    #main_con > app-booking-extras > div > div.fullwidth > div > app-summary > div.footer-wrapper.d-print-none.pdf-print > div.container > div > div.col-2.text-end.uc18 { \r\n        padding-left: 1px;\r\n    }\r\n}\r\n@media (600px <= width <= 756px) {\r\n    #main_con > app-booking-extras > div > div.fullwidth > div > app-summary > div.footer-wrapper.d-print-none.pdf-print > div.container > div > div.col-2.text-end.uc18 { \r\n        width: 200px;\r\n    }\r\n}\r\n@media (501px <= width <= 599px) {\r\n    #main_con > app-booking-extras > div > div.fullwidth > div > app-summary > div.footer-wrapper.d-print-none.pdf-print > div.container > div > div.col-2.text-end.uc18 { \r\n        width: 150px;\r\n    }\r\n}\r\n\r\n@media (width >= 1129px) {\r\n    .sitecore-mobile-text {\r\n        display: none;\r\n    }\r\n}\r\n\r\n@media (width <= 662px) {\r\n    .sitecore-mobile-text {\r\n        font-size: 18px;\r\n    }\r\n}',html:"\x3c!-- define the structure and content of your Experience in HTML e.g.--\x3e\n<div>My Content</div>\n\x3c!-- Use dynamic Guest variables, type ctrl+space or guest to explore available entities.--\x3e\n\x3c!-- Type 'd' to see decisioning helpers --\x3e\n",js:'// You can choose how you want to add your HTML by using insertHTMLBefore, insertHTMLAfter, or replaceHTML methods\r\n// e.g insertHTMLAfter(\'.someClassName\'); or insertHTMLAfter(\'body\'); or replaceHTML(\'#myPageId\')\r\n\r\n//      ?bxQATool=true&bxFlowRef=38413612-8a1e-4e2d-9d91-6284f8bce4a6&bxVariantRef=e8cdbfe8-df1e-418a-8915-cbd7bddfa8be\r\n//      https://ibestage.flynas.com/flynascdp/?bxQATool=true&bxFlowRef=38413612-8a1e-4e2d-9d91-6284f8bce4a6&bxVariantRef=e8cdbfe8-df1e-418a-8915-cbd7bddfa8be#/manage/extras\r\n\r\n(function() {\r\n    \r\n\r\n    console.log("UC1.8 START");\r\n\r\n    let loader = document.querySelector("#main_con > app-loader > div > div.loader-main > div")\r\n    console.log("loader: " + loader)\r\n\r\n    let page = null\r\n    let continueButton = null\r\n    let priceTab\r\n    let buttonWrapper\r\n    let passDataText = null\r\n    let labelEl\r\n    let passData\r\n\r\n    function checkPage() {\r\n        \r\n        // Check what page\r\n        console.log(\'Checking page\')\r\n        if (window.location.hash.includes("booking/extras")) {\r\n            page = window.location.hash\r\n            console.log("page: " + page)\r\n            continueButton = document.querySelector(".btn-continue");\r\n            // priceTab = document.querySelector("#main_con > app-booking-extras > div > div.fullwidth > div > app-summary > div.footer-wrapper.d-print-none.pdf-print.ng-star-inserted > div > div > div.col-8.open-total-fare.hide-mobile > div")\r\n            priceTab = document.querySelector("#main_con > app-booking-extras > div > div.fullwidth > div > app-summary > div.footer-wrapper.d-print-none.pdf-print > div > div > div.col-8.open-total-fare.hide-mobile")\r\n            console.log(\'priceTab in checkPage: \' + priceTab)\r\n            buttonWrapper = document.querySelector("#main_con > app-booking-extras > div > div.fullwidth > div > app-summary > div.footer-wrapper.d-print-none.pdf-print > div > div > div.col-4.text-end")\r\n            \r\n        } else if (window.location.hash.includes("#/manage/extras")) {\r\n            page = window.location.hash\r\n            console.log("page: " + page)\r\n            continueButton = document.querySelector("#summaryNext");\r\n            // priceTab = document.querySelector("#main_con > app-manage-extras > div.fullwidth > div > app-summary > div.footer-wrapper.d-print-none.pdf-print.ng-star-inserted > div.container > div > div.col-6.open-total-fare.hide-mobile")\r\n            // priceTab = document.querySelector("#main_con > app-manage-extras > div.fullwidth > div > app-summary > div.footer-wrapper.d-print-none.pdf-print > div > div > div.col-8.open-total-fare.hide-mobile")\r\n            // priceTab = document.querySelector("#main_con > app-manage-extras > div.fullwidth > div > app-summary > div.footer-wrapper.d-print-none.pdf-print > div > div > div.col-8.open-total-fare.hide-mobile > div")\r\n            priceTab = document.querySelector("#main_con > app-manage-extras > div.fullwidth > div > app-summary > div.footer-wrapper.d-print-none.pdf-print > div > div > div.col-8.open-total-fare.hide-mobile > div")\r\n            //buttonWrapper = document.querySelector("#main_con > app-manage-extras > div.fullwidth > div > app-summary > div.footer-wrapper.d-print-none.pdf-print > div > div > div.col-4.text-end")\r\n            buttonWrapper = document.querySelector("#main_con > app-manage-extras > div.fullwidth > div > app-summary > div.footer-wrapper.d-print-none.pdf-print > div.container > div > div.col-4")\r\n                                                    \r\n            console.log(\'priceTab in checkPage: \' + priceTab)\r\n            \r\n\r\n            \r\n        } else if (window.location.hash.includes("#/wci/extras")) {\r\n            \r\n            if (window.location.hash.includes("#/wci/extras")) {\r\n                page = window.location.hash\r\n                console.log("page: " + page)\r\n                continueButton = document.querySelector("#summaryNext");\r\n                priceTab = document.querySelector("#main_con > app-wci-extras > div.fullwidth > div > app-summary > div.footer-wrapper.d-print-none.pdf-print > div > div > div.col-8.open-total-fare.hide-mobile")\r\n                buttonWrapper = document.querySelector("#main_con > app-wci-extras > div.fullwidth > div > app-summary > div.footer-wrapper.d-print-none.pdf-print > div > div > div.col-4.text-end")\r\n            }\r\n\r\n            \r\n        } else {\r\n            continueButton = null\r\n            console.log(\'page not found\');\r\n        }\r\n        \r\n        \r\n        \r\n    }\r\n\r\n\r\n\r\n\r\n\r\n    function showBar() {\r\n        console.log("showBar");\r\n        \r\n        \r\n        insertText();\r\n        \r\n        \r\n        let footer = document.querySelector(".footer-wrapper");\r\n        footer.style.transition = "1s";\r\n        footer.style.bottom = "-150px";\r\n        let showBar = setInterval(function() {\r\n            const body = document.body;\r\n            const html = document.documentElement;\r\n            const height = Math.max(body.scrollHeight, body.offsetHeight,\r\n                html.clientHeight, html.scrollHeight, html.offsetHeight);\r\n            console.log(height)\r\n            // timer += 1;\r\n            // let carIcon = document.querySelector(".car-icon")\r\n            // let carIconClass = carIcon.parentElement.parentElement.className; \r\n            // console.log("carIconClass: " + carIconClass)  \r\n            window.onscroll = function(ev) {\r\n                // if ((window.innerHeight + Math.round(window.scrollY)) >= document.body.offsetHeight - (window.innerHeight * 3.2)) {\r\n                if ((window.innerHeight + Math.round(window.scrollY) >= height * 0.85)) {\r\n                    // if(elementIsVisibleInViewport(el)){\r\n                    clearInterval(showBar);\r\n                    console.log("UC1.8 elementIsVisibleInViewport");\r\n                    footer.style.bottom = "0px";\r\n                }\r\n            }\r\n        }, 750)\r\n    }\r\n\r\n    // console.log(\'priceTab: \' + priceTab)\r\n\r\n    // Called by showBar, inserts the personalization\r\n    function insertText() {\r\n        console.log("insertText");\r\n\r\n        checkPage()\r\n\r\n        // let continueButton = document.querySelector(".btn-continue")\r\n\r\n        let bundleType = "{{bundleType}}";\r\n        //if it is not booking - but managing existing booking we have bundle type in this variable: passDataText\r\n        if (passDataText!= null){\r\n            bundleType = passDataText.toUpperCase();\r\n        }\r\n        \r\n        //let domesticOrInternational = "{{domesticOrInternational}}";\r\n        let domesticOrInternational = null\r\n\r\n        // bundleType = "LIGHT";\r\n        // bundleType = "LFLX";\r\n        console.log("bundleType: " + bundleType);\r\n        console.log("domesticOrInternational: " + domesticOrInternational);\r\n        const lang = document.documentElement.lang\r\n        // console.log("lang: "+lang);\r\n\r\n        // Editing elements on left and right of the inserted text. Decreasing the col parameter to make room for personalization. \r\n        const totalFare = document.querySelector(".open-total-fare")\r\n\r\n        // console.log("buttonWrapper: "+buttonWrapper)\r\n        //buttonWrapper.classList.add("uc18");\r\n        \r\n        if (buttonWrapper) {\r\n          buttonWrapper.classList.add("uc18");\r\n        } else {\r\n          console.log("no wrapper")\r\n        }\r\n\r\n        \r\n\r\n        // console.log("continueButton1: " + buttonWrapper)\r\n\r\n        totalFare.classList.replace("col-8", "col-6");\r\n        buttonWrapper.classList.replace("col-4", "col-2");\r\n        // let totalFareMobileLandscape = document.querySelector("#main_con > app-booking-extras > div > div.fullwidth > div > app-summary > div.footer-wrapper.d-console.log-none.ng-star-inserted > div.container > div > div.col-6.open-total-fare.hide-mobile > div > span.col-auto.float-start.ng-star-inserted")\r\n\r\n        // // if in landscape mode change totalFare class name to move it down in alighnment with other elements PC-324\r\n        // if(window.innerHeight < window.innerWidth){\r\n        //     totalFareMobileLandscape.className = "hide-mobile ng-star-inserted";\r\n        // }\r\n\r\n        // Copy and translation\r\n        const lightTextEng = "Not enough bags? Add more now!🧳"\r\n        const lightTextAr = "حقائبك لا تكفي؟ اضف المزيد الآن 🧳"\r\n\r\n        const valueTextEng = "Free changes with your bookings!"\r\n        const valueTextAr = "غيّر حجوزاتك مجانًا بكل سهولة!"\r\n        \r\n/*        if (domesticOrInternational == "domestic") {\r\n            \r\n            valueTextEng = "Free changes with your bookings!"\r\n            valueTextAr = "غيّر حجوزاتك مجانًا بكل سهولة!"\r\n            \r\n            //valueTextAr = "TEST AR VALUE DOMESTIC"\r\n         }\r\n        else {\r\n \r\n            valueTextEng = "Free changes with your bookings!"\r\n            valueTextAr = "غيّر حجوزاتك مجانًا بكل سهولة!"\r\n            \r\n            //valueTextAr = "TEST AR VALUE INT"\r\n        }*/\r\n\r\n\r\n        // Creating new HTML elements to insert\r\n        const newDiv = document.createElement("div");\r\n        const mobileDiv = document.createElement("div");\r\n        newDiv.classList.add("col-4");\r\n        newDiv.classList.add("uc-18-sitecore");\r\n        mobileDiv.classList.add("sitecore-mobile-text");\r\n\r\n        // Check language on site and append text\r\n        if (lang == "en") {\r\n            if (bundleType == "LIGHT") {\r\n                newDiv.innerHTML = lightTextEng\r\n                mobileDiv.innerHTML = lightTextEng\r\n            } else if (bundleType == "VALUE") {\r\n                newDiv.innerHTML = valueTextEng\r\n                mobileDiv.innerHTML = valueTextEng\r\n            }\r\n        } else if (lang == "ar") {\r\n\r\n            // buttonWrapper.style.position = "absolute"\r\n            buttonWrapper.removeProperty = "right"\r\n            buttonWrapper.style.setProperty("left", "0")\r\n            \r\n            if (bundleType == "LIGHT" || bundleType == "لايت") {\r\n                newDiv.innerHTML = lightTextAr\r\n                mobileDiv.innerHTML = lightTextAr\r\n            } else if (bundleType == "VALUE" || bundleType == "ڤاليو") {\r\n                newDiv.innerHTML = valueTextAr\r\n                mobileDiv.innerHTML = valueTextAr\r\n            }\r\n        }\r\n        \r\n        // Insert element\r\n        // let wrapDesktop = document.querySelector(".open-total-fare.col-6 .row")\r\n\r\n        // let wrapDesktop = document.querySelector("#main_con > app-booking-extras > div > div.fullwidth > div > app-summary > div.footer-wrapper.d-console.log-none.ng-star-inserted > div > div")\r\n        let wrapDesktop = document.querySelector("div.footer-wrapper > div.container > div.row");\r\n        let wrapMobile = document.querySelector(".footer-wrapper")\r\n\r\n        wrapDesktop.insertBefore(newDiv, buttonWrapper);\r\n        wrapMobile.appendChild(mobileDiv)\r\n        if ((window.location.hash.includes("manage/extras") || window.location.hash.includes("wci/extras")) && lang === "ar") {\r\n            document.querySelector(".uc-18-sitecore").classList.add("ar_mmb");\r\n        }\r\n\r\n        if (window.location.hash.includes("booking/extras")) document.querySelector(".uc-18-sitecore").classList.add("booking");\r\n\r\n\r\n        // If round trip make room for text as the price tab takes up more room\r\n\r\n\r\n        let sitecoreText = document.querySelector(".col-4.uc-18-sitecore")\r\n        console.log("priceTab.childNodes: " + priceTab)\r\n        // debugger;\r\n        // console.log("priceTab.childNodes: " + priceTab.childNodes)\r\n        if (priceTab.childNodes.length > 11) {\r\n            sitecoreText.style.width = "calc(100% - 820px)"\r\n        }\r\n        // debugger;\r\n        // Clear CSS on button on next(seat) page as the personalization still is active(mostlikely doesn\'t see url change because of SPA)\r\n\r\n        // function clearButtonCSS() {\r\n        //     // if (location.hash === \'#/booking/seats\') {\r\n        //         console.log("clearing button CSS")\r\n        //         buttonWrapper.style.position = "relative"\r\n        //     // }\r\n        // }\r\n\r\n        // // buttonWrapper.addEventListener("click", clearButtonCSS)\r\n        // window.addEventListener("hashchange", clearButtonCSS);\r\n        // // window.onhashchange = clearButtonCSS;\r\n        \r\n    }\r\n\r\n    // console.log("continueButton: " + continueButton == null)\r\n    function waitForBundleCode(callback) {\r\n        \r\n        const lang = document.documentElement.lang\r\n        if (lang==\'ar\'){\r\n\r\n            const interval = setInterval(() => {\r\n                const labelEl = Array.from(document.querySelectorAll(\'.pass_label\'))\r\n                    .find(el => el.textContent.trim() === \'الباقة\');\r\n        \r\n                if (labelEl) {\r\n                    const passData = labelEl.parentElement.querySelector(\'.pass_data\');\r\n                    if (passData) {\r\n                        const passDataText = passData.textContent.trim();\r\n                        \r\n                        callback(passDataText);\r\n                    }\r\n                }\r\n            }, 400);\r\n        \r\n            return interval; // Expose interval to the outer scope\r\n            \r\n        }\r\n        else {\r\n        \r\n            const interval = setInterval(() => {\r\n                const labelEl = Array.from(document.querySelectorAll(\'.pass_label\'))\r\n                    .find(el => el.textContent.trim() === \'Bundle Code\');\r\n        \r\n                if (labelEl) {\r\n                    const passData = labelEl.parentElement.querySelector(\'.pass_data\');\r\n                    if (passData) {\r\n                        const passDataText = passData.textContent.trim();\r\n                        \r\n                        callback(passDataText);\r\n                    }\r\n                }\r\n            }, 400);\r\n        \r\n            return interval; // Expose interval to the outer scope\r\n        }\r\n    }\r\n\r\n    let uc_1_8_searchInterval = setInterval(function() {\r\n        console.log(\'IN INTERVAL\')\r\n\r\n        // console.log(\'continueButton present: \' + continueButton === null)\r\n        \r\n        \r\n        if (window.location.hash.includes("#/manage/booking")) {\r\n            //looking for budle code on pages - as we can\'t ussume the user is looking for the same bundlecode that we get from decision model\r\n            if(passDataText == null){\r\n            const myInterval = waitForBundleCode(function(bundleCode) {\r\n                console.log("Found Bundle Code:", bundleCode);\r\n                passDataText = bundleCode\r\n                console.log(\'INTERVAL END\')\r\n                if (passDataText !== null){\r\n                    passDataText = bundleCode.split(" ")[0];\r\n                    clearInterval(myInterval);\r\n                    }\r\n                \r\n                });\r\n\r\n                }\r\n\r\n            }\r\n        else {\r\n\r\n            \r\n            checkPage()\r\n            \r\n            if (continueButton !== null) {\r\n                \r\n                //if (window.location.hash.includes("#/wci")) {\r\n                //    console.log("in wci if")\r\n                //    // if on wci page: no page reloads so need to check for title element to call showBar() function\r\n                //    let wciInterval = setInterval(function() {\r\n                //        console.log("in wci interval")\r\n                //        let title = document.querySelector("#main_con > app-wci-extras > div.container.bottom-padding > div > div.row.extras > div > h1")\r\n                //        if (title.innerText === \'Select Add-ons\') {\r\n                //            clearInterval(wciInterval)\r\n                //            showBar()\r\n                //        }\r\n                //    })\r\n                //}\r\n                console.log(\'INTERVAL END\')\r\n                clearInterval(uc_1_8_searchInterval)\r\n                // checkPage()\r\n                \r\n                showBar()\r\n            }\r\n        }\r\n        \r\n    }, 400)\r\n\r\n    console.log("UC1.8 END");\r\n})();'}}],notificationEnabled:!1},{ref:"453d576a-8150-4798-8a87-fb4d4f4ba434",name:"UC 5.5 Fare Decrease",revision:33,archived:!1,target:{script:"",targetPages:[{operator:"Starts with",value:"https://www.flynas.com"}]},traffic:{type:"advancedTraffic",allocationLow:1,allocationHigh:120,splits:[{ref:"9243345f-972b-4162-887d-e18aff832e0b",lowSplit:1,highSplit:6},{ref:"04cf0b1c-565c-486a-8ecb-8167f96b8c5d",lowSplit:7,highSplit:120}],coupled:!1},variants:[{ref:"9243345f-972b-4162-887d-e18aff832e0b",name:"Original",assets:{css:"/** style your Experience with CSS */",html:"\x3c!-- define the structure and content of your Experience in HTML e.g.--\x3e\n<div>My Content</div>\n\x3c!-- Use dynamic Guest variables, type ctrl+space or guest to explore available entities.--\x3e\n\x3c!-- Type 'd' to see decisioning helpers --\x3e\n",js:"// You can choose how you want to add your HTML by using insertHTMLBefore, insertHTMLAfter, or replaceHTML methods\n// e.g insertHTMLAfter('.someClassName'); or insertHTMLAfter('body'); or replaceHTML('#myPageId')\n\n/*\n\n(function () {\n  // Add statements here\n})();\n\n*/"}},{ref:"04cf0b1c-565c-486a-8ecb-8167f96b8c5d",name:"Variant 1 - Corner Popup (Sitecore Library)",assets:{css:"/*\r\n#fff\r\n#F3F5F7\r\n\r\nArial;\r\n#000\r\n#fff\r\n#9e9e9e\r\n#fff\r\n#F3F5F7\r\n#000\r\n#fff\r\n#000\r\n#4D4D4D\r\n36\r\n#4D4D4D\r\n16\r\n*/\r\n\r\n\r\n@font-face {\r\n            font-family: 'GothamRounded-Bold';\r\n            src: url('./fonts/GothamRounded-Bold.eot?#iefix') format('embedded-opentype'), url('./fonts/GothamRounded-Bold.otf') format('opentype'), url('./fonts/GothamRounded-Bold.woff') format('woff'), url('./fonts/GothamRounded-Bold.ttf') format('truetype'), url('./fonts/GothamRounded-Bold.svg#GothamRounded-Bold') format('svg');\r\n            font-weight: normal;\r\n            font-style: normal;\r\n        }\r\n\r\n\r\n@font-face {\r\n    font-family: 'GothamRounded-Book';\r\n    src: url('./fonts/GothamRounded-Book.eot?#iefix') format('embedded-opentype'), url('./fonts/GothamRounded-Book.otf') format('opentype'), url('./fonts/GothamRounded-Book.woff') format('woff'), url('./fonts/GothamRounded-Book.ttf') format('truetype'), url('./fonts/GothamRounded-Book.svg#GothamRounded-Book') format('svg');\r\n    font-weight: normal;\r\n    font-style: normal;\r\n}\r\n\r\n\r\n@font-face {\r\n    font-family: 'GothamRounded-Light';\r\n    src: url('./fonts/GothamRounded-Light.eot?#iefix') format('embedded-opentype'), url('./fonts/GothamRounded-Light.otf') format('opentype'), url('./fonts/GothamRounded-Light.woff') format('woff'), url('./fonts/GothamRounded-Light.ttf') format('truetype'), url('./fonts/GothamRounded-Light.svg#GothamRounded-Light') format('svg');\r\n    font-weight: normal;\r\n    font-style: normal;\r\n}\r\n\r\n\r\n\r\n@font-face {\r\n    font-family: 'GothamRounded-Medium';\r\n    src: url('./fonts/GothamRounded-Medium.eot?#iefix') format('embedded-opentype'), url('./fonts/GothamRounded-Medium.otf') format('opentype'), url('./fonts/GothamRounded-Medium.woff') format('woff'), url('./fonts/GothamRounded-Medium.ttf') format('truetype'), url('./fonts/GothamRounded-Medium.svg#GothamRounded-Medium') format('svg');\r\n    font-weight: normal;\r\n    font-style: normal;\r\n}\r\n\r\n@font-face {\r\n    font-family: 'flynas-Bold';\r\n    src: url('./fonts/Flynas-Bold.eot');\r\n    src: url('./fonts/Flynas-Bold.eot?#iefix') format('embedded-opentype'), url('./fonts/Flynas-Bold.woff2') format('woff2'), url('./fonts/Flynas-Bold.woff') format('woff'), url('./fonts/Flynas-Bold.ttf') format('truetype'), url('./fonts/Flynas-Bold.svg#Flynas-Bold') format('svg');\r\n    font-weight: bold;\r\n    font-style: normal;\r\n    font-display: swap;\r\n}\r\n\r\n@font-face {\r\n    font-family: 'flynas-Thin';\r\n    src: url('./fonts/Flynas-Thin.eot');\r\n    src: url('./fonts/Flynas-Thin.eot?#iefix') format('embedded-opentype'), url('./fonts/Flynas-Thin.woff2') format('woff2'), url('./fonts/Flynas-Thin.woff') format('woff'), url('./fonts/Flynas-Thin.ttf') format('truetype'), url('./fonts/Flynas-Thin.svg#Flynas-Thin') format('svg');\r\n    font-weight: 100;\r\n    font-style: normal;\r\n    font-display: swap;\r\n}\r\n\r\n@font-face {\r\n    font-family: 'flynas-Light';\r\n    src: url('./fonts/Flynas-Light.eot');\r\n    src: url('./fonts/Flynas-Light.eot?#iefix') format('embedded-opentype'), url('./fonts/Flynas-Light.woff2') format('woff2'), url('./fonts/Flynas-Light.woff') format('woff'), url('./fonts/Flynas-Light.ttf') format('truetype'), url('./fonts/Flynas-Light.svg#Flynas-Light') format('svg');\r\n    font-weight: 300;\r\n    font-style: normal;\r\n    font-display: swap;\r\n}\r\n\r\n@font-face {\r\n    font-family: 'flynas-Regular';\r\n    src: url('./fonts/Flynas-Regular.eot');\r\n    src: url('./fonts/Flynas-Regular.eot?#iefix') format('embedded-opentype'), url('./fonts/Flynas-Regular.woff2') format('woff2'), url('./fonts/Flynas-Regular.woff') format('woff'), url('./fonts/Flynas-Regular.ttf') format('truetype'), url('./fonts/Flynas-Regular.svg#Flynas-Regular') format('svg');\r\n    font-weight: normal;\r\n    font-style: normal;\r\n    font-display: swap;\r\n}\r\n\r\n@font-face {\r\n    font-family: 'flynas-Medium';\r\n    src: url('./fonts/Flynas-Medium.eot');\r\n    src: url('./fonts/Flynas-Medium.eot?#iefix') format('embedded-opentype'), url('./fonts/Flynas-Medium.woff2') format('woff2'), url('./fonts/Flynas-Medium.woff') format('woff'), url('./fonts/Flynas-Medium.ttf') format('truetype'), url('./fonts/Flynas-Medium.svg#Flynas-Medium') format('svg');\r\n    font-weight: 500;\r\n    font-style: normal;\r\n    font-display: swap;\r\n}\r\n\r\n@font-face {\r\n    font-family: 'flynas-SemiBold';\r\n    src: url('./fonts/Flynas-SemiBold.eot');\r\n    src: url('./fonts/Flynas-SemiBold.eot?#iefix') format('embedded-opentype'), url('./fonts/Flynas-SemiBold.woff2') format('woff2'), url('./fonts/Flynas-SemiBold.woff') format('woff'), url('./fonts/Flynas-SemiBold.ttf') format('truetype'), url('./fonts/Flynas-SemiBold.svg#Flynas-SemiBold') format('svg');\r\n    font-weight: 600;\r\n    font-style: normal;\r\n    font-display: swap;\r\n}\r\n\r\n@font-face {\r\n    font-family: 'Flynas-ExtraBold';\r\n    src: url('./fonts/Flynas-ExtraBold.eot');\r\n    src: url('./fonts/Flynas-ExtraBold.eot?#iefix') format('embedded-opentype'), url('./fonts/Flynas-ExtraBold.woff2') format('woff2'), url('./fonts/Flynas-ExtraBold.woff') format('woff'), url('Flynas-ExtraBold.ttf') format('truetype'), url('./fonts/Flynas-ExtraBold.svg#Flynas-ExtraBold') format('svg');\r\n    font-weight: bold;\r\n    font-style: normal;\r\n    font-display: swap;\r\n}\r\n\r\nbody {\r\n    font-family: 'flynas-Regular' !important;\r\n}\r\n\r\n\r\n\r\n#pers-{{ref}} a,\r\n#pers-{{ref}} p,\r\n#pers-{{ref}} span {\r\n  font-family: 'flynas-Regular';\r\n  font-weight: 400;\r\n  line-height: 1.2;\r\n}\r\n\r\n#pers-{{ref}} #pers-transition-card {\r\n    position: fixed;\r\n    width: 435px;\r\n    left: 0; /*lszoto - moving all to left*/\r\n    bottom: -1000px;\r\n    z-index: 999999;\r\n    transition: bottom .6s ease-in-out;\r\n    margin-bottom: 0;\r\n    border-radius: 4px;\r\n    background-color: #fff;\r\n    overflow: hidden;\r\n    box-shadow: 0 0.2rem 0.4rem 0.2rem rgba(0,0,0,.1);\r\n    font-size: initial;\r\n}\r\n\r\n#pers-{{ref}} #pers-transition-card.open {\r\n    bottom: 0;\r\n}\r\n\r\n#pers-{{ref}} #pers-transition-card .img-container {\r\n    display: none; /* lszoto - removing img diplay*/\r\n    width: 100%;\r\n    height: 250px;\r\n}\r\n\r\n#pers-{{ref}} #pers-transition-card .img-container__image {\r\n    margin: 0;\r\n    background: #F3F5F7;\r\n    height: 100%;\r\n    display: flex;\r\n    justify-content: center;\r\n    align-items: center;\r\n    font-size: var(--font-size-h4);\r\n    background-image: url(\"\");\r\n    background-position: center;\r\n    background-repeat: no-repeat;\r\n    background-size: cover;\r\n}\r\n\r\n#pers-{{ref}} #pers-transition-card .pers-transition-card__body {\r\n    padding: 37px 34px;\r\n}\r\n\r\n#pers-{{ref}} #pers-transition-card .pers-transition-card__body h3 {\r\n    margin-top: 28px;\r\n    line-height: 1.5;\r\n    font-size: 36px;\r\n    font-weight: bold;\r\n    text-align: center;\r\n    margin: 0;\r\n    color: #08bcb4; /*lszoto - changing colour of the title from: #4D4D4D */\r\n    font-family: 'flynas-Bold';\r\n}\r\n\r\n#pers-{{ref}} #pers-transition-card .pers-transition-card__body p {\r\n    padding: 12px 0;\r\n    margin: 0;\r\n    font-size: 16px;\r\n    line-height: 28px;\r\n    text-align: center;\r\n    color: #4D4D4D;\r\n    font-family: 'flynas-Regular';\r\n}\r\n\r\n#pers-{{ref}} #pers-transition-card .options-container {\r\n    display: flex;\r\n    /* lszoto changes: justify-content: center; */\r\n    flex-direction: column;  /* lszoto: stack vertically */\r\n    gap: 10px;               /* lszoto: space between buttons */\r\n    align-items: stretch;    /* lszoto: allow buttons to stretch full width */\r\n}\r\n\r\n#pers-{{ref}} #pers-transition-card .options-container__primary {\r\n    display: inline-block;\r\n    border-radius: 4px;\r\n    color: #fff;\r\n    background-color: #000;\r\n    padding: 20px 40px; /*changing from padding: 10px 30px;*/\r\n    cursor: pointer;\r\n    font-size: Arial;\r\n}\r\n\r\n#pers-{{ref}} #pers-transition-card .options-container__primary:hover {\r\n  color: #fff;\r\n  background-color: #9e9e9e;\r\n}\r\n\r\n#pers-{{ref}} #pers-transition-card .options-container__secondary {\r\n    display: inline-block;\r\n    border: 1px solid #C1C9D0;\r\n    border-radius: 4px;\r\n    color: #000;\r\n    background-color: #F3F5F7;\r\n    padding: 20px 40px;\r\n    margin-right: 0px; /*lszoto changing from margin-right: 13px;*/\r\n    cursor: pointer;\r\n    font-size: Arial;\r\n}\r\n\r\n#pers-{{ref}} #pers-transition-card .options-container__secondary:hover {\r\n  color: #000;\r\n  background-color: #fff;\r\n}\r\n\r\n/*lszoto: Primary button styles */\r\n#pers-{{ref}} #pers-transition-card .options-container__primary,\r\n#pers-transition-card--primary {\r\n    background-color: #08bcb4;\r\n    color: #ffffff;\r\n}\r\n\r\n/* lszoto: Secondary button styles */\r\n#pers-{{ref}} #pers-transition-card .options-container__secondary,\r\n#pers-transition-card--secondary {\r\n    background-color: #ffffff;\r\n    color: #000000;\r\n    border: 1px solid #C1C9D0; /* optional border */\r\n}\r\n\r\n/* lszoto: Make buttons rounder */\r\n#pers-{{ref}} #pers-transition-card .options-container__primary,\r\n#pers-transition-card--primary,\r\n#pers-{{ref}} #pers-transition-card .options-container__secondary,\r\n#pers-transition-card--secondary {\r\n    border-radius: 50px;  /* makes buttons very round */\r\n}\r\n\r\n/* lszoto: Secondary button border color */\r\n#pers-{{ref}} #pers-transition-card .options-container__secondary,\r\n#pers-transition-card--secondary {\r\n    border: 1px solid #08bcb4; /* colored outer line */\r\n}\r\n/* lszoto: buttons bold text */\r\n#pers-{{ref}} #pers-transition-card .options-container__primary,\r\n#pers-transition-card--primary,\r\n#pers-{{ref}} #pers-transition-card .options-container__secondary,\r\n#pers-transition-card--secondary {\r\n    font-weight: bold;  /* make button text bold */\r\n}\r\n\r\n/*lszoto: both buttons same width*/\r\n#pers-{{ref}} #pers-transition-card .options-container__primary,\r\n#pers-{{ref}} #pers-transition-card .options-container__secondary {\r\n    flex: 1; /* both buttons take full width of container */\r\n    text-align: center; /* keep text centered */\r\n}\r\n/*lszoto add bottom title part*/\r\n#pers-{{ref}} #pers-transition-card .pers-transition-card__body #popupTitleBottom {\r\n    font-size: 22px;        /* smaller than popupTitle */\r\n    color: #08bcb4;         /* same as popupTitle */\r\n    font-family: 'flynas-Regular';\r\n    font-weight: bold;\r\n    line-height: 1.5;\r\n    text-align: center;\r\n    margin: 2px 0 0 0;      /* minimal space below the h3 */\r\n}\r\n/*lszoto: removing margins*/\r\n#pers-{{ref}} #pers-transition-card .pers-transition-card__body h3#popupTitle {\r\n    margin: 0; /* remove default top/bottom margin */\r\n}\r\n\r\n/*Popup width auto under 434px width screens*/\r\n@media (max-width: 435px) {\r\n    #pers-transition-card {\r\n        width: auto !important;\r\n    }\r\n}\r\n\r\n/*lszoto: resiize arrow image*/\r\n#popupImage {\r\n    display: block;\r\n    width: 40%;\r\n    height: auto;\r\n    margin: 0 auto 16px; /* centers the image and adds space below */\r\n}\r\n",html:'\x3c!-- Use dynamic Guest variables, type ctrl+space or guest to explore available entities.--\x3e\n\x3c!-- Type "d" to see decisioning helpers --\x3e\n<div id="pers-transition-card">\n    <div class="img-container">\n        <div class="img-container__image"></div>\n    </div>\n    <div class="pers-transition-card__body">\n        <img id="popupImage" src="">\n        <h3 id="popupTitle">Title</h3>\n        <h3 id="popupTitleBottom">Additional info</h3>\n        <p id="popupText">Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt</p>\n        <div class="options-container">\n            <a id="pers-transition-card--primary" class="options-container__primary">Yes Please</a>\n            <a id="pers-transition-card--secondary" class="options-container__secondary">No Thanks</a>\n        </div>\n    </div>\n</div>',js:'(function() {\n\n    let dm_titleTop = "{{titleTop}}";\n    let dm_titleBottom = "{{titleBottom}}";\n    let dm_text = "{{text}}";\n    let dm_cta1 = "{{cta1}}";\n    let dm_cta1link = "{{cta1link}}";\n    let dm_cta2 = "{{cta2}}";\n    let dm_arrowImg = "{{arrowImg}}";\n    // let priceIsLower = "{{priceIsLower}}";\n    let priceIsLower = "true";\n    let isEngageAvailable\n    let isScCloudSDKAvailable\n\n    if (priceIsLower === "false") {\n        console.log("Price found was not lower. No personalization.")\n        sendInteractionToPersonalize("BLOCKED");\n        \n    } else {\n        // Check if Engage or scCloudSDK is available in the window object\n        isEngageAvailable = typeof window.Engage !== \'undefined\';\n        isScCloudSDKAvailable = typeof window.scCloudSDK !== \'undefined\';\n\n        const webLibTemplating = isEngageAvailable ?\n            Engage?.templating :\n            scCloudSDK?.personalize?.templating;\n        // Adds a unique variant identifier to CSS when deployed to ensure CSS does not impact styling of other elements.\n        var compiledCSS = webLibTemplating.compile(variant.assets.css)(variant);\n        var styleTag = document.getElementById(\'style-\' + variant.ref);\n        if (styleTag) {\n            styleTag.innerHTML = compiledCSS;\n        }\n        // End Adds a unique variant identifier to CSS when deployed to ensure CSS does not impact styling of other elements.\n\n        // make space in the body for the experience\n        insertHTMLAfter(\'body\', \'pers-\');\n        var persContent = document.querySelector("#pers-" + variant.ref + " #pers-transition-card");\n\n\n        //updating the text values:\n        //titleTop:\n        document.getElementById("popupTitle").innerHTML = dm_titleTop;\n        //titleBottom:\n        document.getElementById("popupTitleBottom").innerHTML = dm_titleBottom;\n        //text:\n        dm_text = dm_text.replace(/\\.(.+)?/, ".<br>$1"); //splitting text to new line\n        document.getElementById("popupText").innerHTML = dm_text;\n        //cta1:\n        document.getElementById("pers-transition-card--primary").innerHTML = dm_cta1;\n        //cta2:\n        document.getElementById("pers-transition-card--secondary").innerHTML = dm_cta2;\n        \n        //updating arrow image src\n        document.getElementById("popupImage").src = dm_arrowImg;\n\n        setTimeout(function() {\n            persContent.classList.add("open");\n            sendInteractionToPersonalize("VIEWED");\n        });\n\n        var persCardClose = document.body.querySelector("#pers-" + variant.ref + " #pers-transition-card--secondary");\n        persCardClose.onclick = function() {\n            sendInteractionToPersonalize("DISMISSED");\n            persContent.classList.remove("open");\n        }\n\n        var persCardCta = persContent.querySelector("#pers-" + variant.ref + " #pers-transition-card--primary");\n        // console.log("dm_link: "+dm_cta1link.replace(/&#x3D;/g, "=").replace(/&amp;/g, "&"))\n        persCardCta.href = dm_cta1link.replace(/&#x3D;/g, "=").replace(/&amp;/g, "&")\n        persCardCta.onclick = function() {\n            sendInteractionToPersonalize("CLICKED");\n            // window.location.href = "{{cta1link}}";\n        }\n    }\n\n\n    function sendInteractionToPersonalize(interactionType) {\n        const type = "UC5.5_INTERACTION";\n        const eventData = {\n            "channel": "WEB",\n        };\n\n        if (isEngageAvailable) {\n            eventData.pointOfSale = Engage.settings.pointOfSale;\n            eventData.interactionID = "UC5.5 PERS_CORNER_POPUP";\n            eventData.interactionType = interactionType;\n            window.engage.event(type, eventData);\n        } else if (isScCloudSDKAvailable) {\n            eventData.type = type;\n            eventData.extensionData = {\n                "interactionID": "UC5.5 PERS_CORNER_POPUP",\n                "interactionType": interactionType\n            }\n            scCloudSDK.events.event(eventData);\n        }\n    }\n\n})();'}}],notificationEnabled:!1},{ref:"3fb4f1ba-2097-46b0-98a4-1fc7f2cdfcac",name:"UC 1.6 Return flight ancillaries - Multi City enhancement",revision:5,archived:!1,target:{script:'// Use client-side JavaScript to more specifically target users\n// NOTE: When your targeting conditions are met you must call targetingPassed() \n\n(function () {\n    const pathnames = ["/", "/ar", "/en", "/en-ae", "/ar/weekend-sale", "/en/book-flight", "/ar/tiers-and-benefits", \n    "/en/weekend-sale", "/ar/plan-my-trip/seat-selection", "/en-eu/book-flight", "/ar/earn-nasmiles", \n    "/ar/help/online-checkin", "/en-eu/manage-booking", "/ar/book-flight", "/en/manage-booking", "/ar/manage-booking", \n    "/ar/plan-my-trip/baggage", "/en/help/online-checkin", "/ar/contact-us/faqs", "/en/plan-my-trip/baggage", "/ar/international-offer", \n    "/en/booking-flynas/fare-types", "/ar/redeem-smiles", "/ar/domestic-offer", \n    "/en/tiers-and-benefits", "/ar/booking-flynas/fare-types", "/en/media-center/news-updates", "/ar/evisa", "/en/international-offer", \n    "/ar/plan-my-trip/airports-terminals", "/ar/home", "/en/aramcoltp", "/ar/help", \n    "/en/help/flight-status", "/en/domestic-offer", "/ar/nasmiles-contact-us"];\n    \n    const excludedPathnames = ["flights-from", "/en/flights", "/ar/flights"];\n    \n    const pathname = window.location.pathname;\n    if(window.location.host.includes("booking")){\n        return;\n    }\n    if(pathnames.includes(pathname) && !pathname.includes(excludedPathnames)){\n        targetingPassed();\n    }\n})();',targetPages:[]},traffic:{type:"advancedTraffic",allocationLow:1,allocationHigh:120,splits:[{ref:"5b0d8a1a-ef00-4124-bf19-ec857b4ea6d2",lowSplit:1,highSplit:6},{ref:"f1470243-d008-4af9-a500-acbb26150475",lowSplit:7,highSplit:120}],coupled:!1},variants:[{ref:"f1470243-d008-4af9-a500-acbb26150475",name:"Variant 1",assets:{css:"/** style your Experience with CSS */\n#uc_1_6{\n    position: fixed;\n    top: 350px;\n    right: 0px;\n    z-index: 1009;\n    width: 300px;\n    font-family: 'Flynas-Medium';\n    animation: uc_1_6_banner-animation 2s;\n}\n\n#uc_1_6 .background{\n    /*height: 110px;*/\n    border-top-left-radius: 5px;\n    border-bottom-left-radius: 5px;\n    background: white;\n    box-shadow: 0 0 10px rgba(0, 0, 0, .6);\n}\n\n#uc_1_6 .text{\n    width: 100%;\n    text-align: center;\n    color: #00aea3;\n    padding: 19px 10px 10px 10px;\n    \n}\n#uc_1_6 button{\n    right: -100px;\n    position: relative;\n    margin-bottom: 15px;\n}\n#uc_1_6 .escape{\n    cursor: pointer;\n    position: absolute;\n    top: 5px;\n    right: 5px;\n    display: block;\n    width: 15px;\n    height: 15px;\n    background-position: -618px -293px !important;\n    background-size: 1000px !important;\n    background: url(/images/sprite-icons.svg);\n}\n@keyframes uc_1_6_banner-animation {\n  0% {\n    right: -310px;\n  }\n  100%{ \n    right: 0px; \n  }\n}\n\n#uc_1_6.ar{\n    left: 0px;\n    right: unset;\n    animation: uc_1_6_banner-animation-ar 2s;\n}\n#uc_1_6.ar .background{\n    border-top-left-radius: 0px;\n    border-bottom-left-radius: 0px;\n    border-top-right-radius: 5px;\n    border-bottom-right-radius: 5px;\n}\n#uc_1_6.ar .escape{\n    top: 5px;\n    left: 5px;\n    right: unset;\n}\n#uc_1_6.ar button{\n    right: 100px;\n}\n\n@keyframes uc_1_6_banner-animation-ar {\n  0% {\n    left: -310px;\n  }\n  100%{ \n    left: 0px; \n  }\n}\n\n@media screen and (max-height: 510px) {\n    #uc_1_6{\n    \n        top: auto;\n        bottom: 110px;\n    }\n}\n@media screen and (max-width: 415px) {\n    #uc_1_6{\n        width: 100%;\n    }\n    #uc_1_6 .background{\n        align-content: center;\n        border-top-left-radius: 0px; \n        border-bottom-left-radius: 0px;\n    }\n    #uc_1_6.ar .background {\n        border-top-right-radius: 0px;\n        border-bottom-right-radius: 0px;\n    }\n    #uc_1_6 button{\n        margin-right: auto;\n        margin-left: auto;\n        display: block;\n        right: auto;\n    }\n    #uc_1_6.ar button{\n        right: auto;\n    }\n    @keyframes uc_1_6_banner-animation {\n      0% {\n        right: -100%;\n      }\n      100%{ \n        right: 0px; \n      }\n    }\n    @keyframes uc_1_6_banner-animation-ar {\n      0% {\n        left: -100%;\n      }\n      100%{ \n        left: 0px; \n      }\n    }\n}\n",html:'\x3c!-- define the structure and content of your Experience in HTML e.g.--\x3e\n<div id="uc_1_6" class="ar">\n    <div class="background">\n        <i class="escape"></i>\n        <div class="text">\n            Returning with more bags, make sure you can take them all the way home\n        </div>\n        <button class="btn btn-primary btn-sm">\n            Add\n        </button>\n    </div>\n</div>\n\x3c!-- Use dynamic Guest variables, type ctrl+space or guest to explore available entities.--\x3e\n\x3c!-- Type \'d\' to see decisioning helpers --\x3e\n',js:'(function() {\n\n    let bag = "{{audienceFilter.bag}}";\n    let seat = "{{audienceFilter.seat}}";\n    let meal = "{{audienceFilter.meal}}";\n\n    let testId = 0;\n    if (bag === "0" && seat === "0" && meal === "0") {\n        testId = 0;\n    } else if (bag === "0") {\n        testId = 1;\n    } else if (bag === "1" && seat === "0") {\n        testId = 3;\n    } else if (bag === "1" && seat === "1") {\n        testId = 2;\n    }\n    console.log("testId " + testId);\n\n    let lang;\n    if (document.body.classList.contains("arabic")) {\n        lang = "ar";\n    } else {\n        lang = "en";\n    }\n    let parentElement = document.querySelector(".swiper-form-wrap");\n    let htmlVerios = "bag";\n\n    let text;\n    switch (lang) {\n        case "en":\n            text = [\n                "Returning with more bags, make sure you can take them all the way home",\n                "Pick up some souvenirs? Add extra luggage now and bring back your favorite finds!",\n                "Feeling Hungry? Pre-order your meal now",\n                "Travel home in comfort! Select your seat now",\n                "Add now"\n            ]\n            break;\n        case "ar":\n            text = [\n                "هل قمت بإضافة حقائب في رحلة العودة؟ تاكد من حملها معك قبل السفر.",\n                "رحلتك مليئة بالتسوق؟ تأكد من اضافة الوزن الى امتعتك وخذ كل مشترياتك",\n                "تشعر بالجوع؟ اختر وجبتك مسبقاَ واستمتع بها في الرحلة.",\n                "احجز رحلة العودة في راحة تامة! اختر مقعدك الآن",\n                "أضف الآن"\n            ]\n            break;\n    }\n    insertHTMLAfter(\'body\');\n    if (lang === "en") {\n        document.querySelector("#uc_1_6").classList.remove("ar");\n    }\n    document.querySelector("#uc_1_6 .text").innerText = text[testId];\n    document.querySelector("#uc_1_6 button").innerText = text[4];\n    document.querySelector("#uc_1_6 button").addEventListener("click", onBtnClick);\n    document.querySelector("#uc_1_6 .escape").addEventListener("click", function(){\n        document.querySelector("#uc_1_6").style.display = "none";\n    });\n\n    function sendCustomEvent(type) {\n        const eventData2 = {\n            channel: "WEB",\n            currency: "EUR",\n            pointOfSale: Engage.settings.pointOfSale,\n            language: "EN",\n            page: location.pathname\n        };\n        engage.event(type, eventData2);\n    }\n\n    function onBtnClick() {\n        sendCustomEvent("1_6_CLICK");\n\n        let newlang;\n        if (lang === "en") {\n            newlang = "en-US";\n        } else {\n            newlang = "en-GB";\n        }\n        setTimeout(function() {\n            if (window.location.hostname === \'www.flynas.com\') {\n                window.location.href = "https://booking.flynas.com/#/manage/search?lang=" + newlang;\n            } else {\n                window.location.href = "https://ibeuat.flynas.com/flynascdp/#/manage/search?lang=" + newlang;\n            }\n        }, 500);\n    }\n})();'}},{ref:"5b0d8a1a-ef00-4124-bf19-ec857b4ea6d2",name:"Original",assets:{css:"/** style your Experience with CSS */",html:"\x3c!-- define the structure and content of your Experience in HTML e.g.--\x3e\n<div>My Content</div>\n\x3c!-- Use dynamic Guest variables, type ctrl+space or guest to explore available entities.--\x3e\n\x3c!-- Type 'd' to see decisioning helpers --\x3e\n",js:"// You can choose how you want to add your HTML by using insertHTMLBefore, insertHTMLAfter, or replaceHTML methods\n// e.g insertHTMLAfter('.someClassName'); or insertHTMLAfter('body'); or replaceHTML('#myPageId')\n\n/*\n\n(function () {\n  // Add statements here\n})();\n\n*/"}}],notificationEnabled:!1},{ref:"11175ccb-ee87-406c-bf57-dcfd2cc13684",name:"UC 2.3 Destination Promotions",revision:17,archived:!1,target:{script:'// Use client-side JavaScript to more specifically target users\n// NOTE: When your targeting conditions are met you must call targetingPassed() \n\n(function () {\n\n    const pathnames = ["/", "/en", "/ar", "/ar/home", "/en/home", "/en-ae", "/ar/weekend-sale", "/en/book-flight", "/ar/tiers-and-benefits",\n"/en/weekend-sale", "/ar/plan-my-trip/seat-selection", "/en-eu/book-flight", "/ar/earn-nasmiles",\n"/en/flights-from-berlin-to-saudi-arabia", "/ar/help/online-checkin", "/en-eu/manage-booking",\n"/ar/book-flight", "/en/manage-booking", "/ar/manage-booking", "/en/flights", "/ar/plan-my-trip/baggage",\n"/en/help/online-checkin", "/ar/contact-us/faqs", "/en/plan-my-trip/baggage", "/ar/international-offer",];\n    \n    const excludedPathnames = ["/en/help"];\n    \n    const pathname = window.location.pathname;\n    if(window.location.host.includes("booking")){\n        return;\n    }\n    if(pathnames.includes(pathname) && !pathname.includes(excludedPathnames)){\n        targetingPassed();\n    }\n\n})();',targetPages:[]},traffic:{type:"advancedTraffic",allocationLow:1,allocationHigh:120,splits:[{ref:"729db754-3c9e-474b-a7de-a1bdcd111dc9",lowSplit:1,highSplit:6},{ref:"627e5401-04f0-4f83-b178-ff9632c76aad",lowSplit:7,highSplit:120}],coupled:!1},variants:[{ref:"627e5401-04f0-4f83-b178-ff9632c76aad",name:"Variant 1",assets:{css:"#test_uc_2_3_destination_promotions{\n    width: 386px;\n    /*height: 341px;*/\n    background-color: white;\n    position: fixed;\n    top: 350px;\n    /*top: 0px;*/\n    right: -450px;\n    z-index: 1000;\n    box-shadow: 0 0 15px rgba(0, 0, 0, .3);\n    border-radius: 17px;\n    transition: 0.5s;\n\n}\n#test_uc_2_3_destination_promotions.ar{\n    left: -450px;\n    right: auto;\n}\n#test_uc_2_3_destination_promotions.open{\n\n    right: 10px;\n}\n#test_uc_2_3_destination_promotions.ar.open{\n\n    left: 10px;\n    right: auto;\n}\n#test_uc_2_3_destination_promotions p{\n    color: #00bfb3;\n    margin-bottom: -4px;\n}\n#test_uc_2_3_destination_promotions .uc_2_3_content{\n    /*background-color: red;*/\n    margin: 24px;\n}\n#test_uc_2_3_destination_promotions .uc_2_3_title{\n    width: 100%;\n    margin-bottom: 10px;\n    color: #00bfb3;\n    font-size: larger;\n}\n#test_uc_2_3_destination_promotions .uc_2_3_escape{\n    cursor: pointer;\n    position: absolute;\n    top: 15px;\n    right: 15px;\n    display: block;\n    width: 15px;\n    height: 15px;\n    background-position: -618px -293px !important;\n    background-size: 1000px !important;\n    background: url(/images/sprite-icons.svg);\n}\n#test_uc_2_3_destination_promotions.ar .uc_2_3_escape{\n    left: 15px;\n    right: auto;\n}\n\n\n#test_uc_2_3_destination_promotions .uc_2_3_panel{\n    width: 100%;\n    /*background-color: blue;*/\n    margin-top: 10px;\n    height: 66px;\n    cursor: pointer;\n    transition: 0.1s;\n}\n\n#test_uc_2_3_destination_promotions .uc_2_3_panel.panel7:hover .uc_2_3_panel_arrows{\n    transform: translate(20px,0px);\n}\n#test_uc_2_3_destination_promotions .uc_2_3_panel.panel7:hover{\n    transform: translate(10px,0px);\n    background-color: #00bfb317;\n}\n#test_uc_2_3_destination_promotions.ar .uc_2_3_panel.panel7:hover .uc_2_3_panel_arrows{\n    transform: translate(-20px,0px) rotateY(180deg);\n}\n#test_uc_2_3_destination_promotions.ar .uc_2_3_panel.panel7:hover{\n    transform: translate(-10px,0px);\n}\n\n#test_uc_2_3_destination_promotions .uc_2_3_img{\n    width: 100px;\n    height: 100%;\n    border-radius: 8px;\n    float: left;\n}\n\n#test_uc_2_3_destination_promotions.ar .uc_2_3_img{\n    float: right;\n}\n#test_uc_2_3_destination_promotions .uc_2_3_panel_text{\n    float: left;\n    margin-left: 27px;\n    margin-top: 13px;\n    font-weight: bold;\n}\n#test_uc_2_3_destination_promotions.ar .uc_2_3_panel_text{\n    float: right;\n    margin-left: 0px;\n    margin-right: 27px;\n    letter-spacing: 0.5px;\n}\n#test_uc_2_3_destination_promotions .uc_2_3_underline{\n    margin-top: 10px;\n    height: 2px;\n    background-color: #e0e0e0;\n    width: 100%;\n}\n#test_uc_2_3_destination_promotions .uc_2_3_panel_arrows{\n    float: right;\n    margin-top: 22px;\n    margin-right: 30px;\n    transition: transform 0.1s;\n}\n#test_uc_2_3_destination_promotions.ar .uc_2_3_panel_arrows{\n    float: left;\n    margin-right: 0px;\n    margin-left: 30px;\n    transform: rotateY(180deg);\n}\n#test_uc_2_3_destination_promotions .arrow{\n    margin-left: -16px;\n    transform: rotate(-90deg);\n    background-position: -967px -390px !important;\n    width: 19px;\n    height: 16px;\n    vertical-align: middle;\n    background: url(/images/sprite-icons.svg);\n    display: inline-block;\n    background-size: 1000px;\n}\n@media screen and (max-width: 480px) {\n    #test_uc_2_3_destination_promotions.open {\n        right: 0px;\n    }\n    #test_uc_2_3_destination_promotions.ar.open {\n    left: 0px;\n    right: auto;\n    }\n    #test_uc_2_3_destination_promotions {\n        top: 158px;\n        width: 100%;\n    }\n}\n@media only screen and (orientation: landscape) and (max-height: 600px) {\n    #test_uc_2_3_destination_promotions {\n        top: 80px;\n        z-index: 99999;\n        border-radius: 0px;\n        width: 100%;\n        right: -110%;\n        box-shadow: 0 0 3px rgba(0, 0, 0, .3);\n    }\n    #test_uc_2_3_destination_promotions.ar {\n        right: auto;\n        left: -110%;\n    }\n    #test_uc_2_3_destination_promotions.open {\n        right: 0px;\n    }\n    #test_uc_2_3_destination_promotions.ar.open {\n        left: 0px;\n        right: auto;\n    }\n    #test_uc_2_3_destination_promotions .uc_2_3_panel {\n        width: 33.3%;\n        float: left;\n        margin-bottom: 10px;\n    }\n    #test_uc_2_3_destination_promotions .uc_2_3_underline {\n        display: none;\n    }\n    #test_uc_2_3_destination_promotions .uc_2_3_panel_arrows {\n        display: none;\n    }\n    #test_uc_2_3_destination_promotions .uc_2_3_panel_text {\n        margin-left: 17px;\n        \n    }\n    #test_uc_2_3_destination_promotions .uc_2_3_content {\n        margin: 20px 10px;\n    }\n    #test_uc_2_3_destination_promotions .uc_2_3_title {\n        margin-bottom: 0px;\n        text-align: center;\n    }\n    #test_uc_2_3_destination_promotions .uc_2_3_text{\n        text-align: center; \n    }\n    #test_uc_2_3_destination_promotions .uc_2_3_content.panelRemoved .uc_2_3_panel{\n        width: 290px;\n        \n        /*margin-right:;*/\n    }\n    #test_uc_2_3_destination_promotions .uc_2_3_content.panelRemoved > div:nth-child(4){\n        margin-left: calc(50% - 230px);\n    }\n    #test_uc_2_3_destination_promotions.ar .uc_2_3_content.panelRemoved > div:nth-child(4){\n        margin-left: calc(50% - 300px);\n    }\n    #test_uc_2_3_destination_promotions .uc_2_3_content.onePanel .uc_2_3_panel{\n        width: 290px;\n        margin-left: calc(50% - 100px);\n        /*margin-right:;*/\n    }\n    #test_uc_2_3_destination_promotions.ar .uc_2_3_content.onePanel .uc_2_3_panel{\n        margin-left: calc(50% - 185px);\n        /*margin-right:;*/\n    }\n}\n@media only screen and (orientation: landscape) and (max-height: 400px) {\n    #test_uc_2_3_destination_promotions .uc_2_3_panel {\n        font-size: 13px;\n    }\n    #test_uc_2_3_destination_promotions .uc_2_3_content.panelRemoved .uc_2_3_panel{\n        width: 260px;\n    }\n    #test_uc_2_3_destination_promotions .uc_2_3_img {\n        width: 90px;\n        height: 90%;\n    }\n    #test_uc_2_3_destination_promotions.ar .uc_2_3_panel_text {\n        margin-right: 7px;\n    }\n}\n",html:'\x3c!-- define the structure and content of your Experience in HTML e.g.--\x3e\n<div id="test_uc_2_3_destination_promotions" class="">\n    <div class="uc_2_3_content">\n        <i class="uc_2_3_escape"></i>\n        <div class="uc_2_3_title">\n            Welcome back Sridhar\n        </div>\n        <div class="uc_2_3_text">\n            We have hand picked some destinations for you. Discover more, spread your wings:\n        </div>\n            <div class="uc_2_3_panel panel7">\n            <img class="uc_2_3_img" src="https://static.flynas.com/media/ngckklnt/szg.jpg">\n            <div class="uc_2_3_panel_text">\n                <p>Tirana</p>\n                example 5\n            </div>\