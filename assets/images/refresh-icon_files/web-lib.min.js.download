truetype'), url('./fonts/Flynas-SemiBold.svg#Flynas-SemiBold') format('svg');\r\n    font-weight: 600;\r\n    font-style: normal;\r\n    font-display: swap;\r\n}\r\n\r\n@font-face {\r\n    font-family: 'Flynas-ExtraBold';\r\n    src: url('./fonts/Flynas-ExtraBold.eot');\r\n    src: url('./fonts/Flynas-ExtraBold.eot?#iefix') format('embedded-opentype'), url('./fonts/Flynas-ExtraBold.woff2') format('woff2'), url('./fonts/Flynas-ExtraBold.woff') format('woff'), url('Flynas-ExtraBold.ttf') format('truetype'), url('./fonts/Flynas-ExtraBold.svg#Flynas-ExtraBold') format('svg');\r\n    font-weight: bold;\r\n    font-style: normal;\r\n    font-display: swap;\r\n}\r\n\r\nbody {\r\n    font-family: 'flynas-Regular';\r\n}\r\n\r\n.reminder-container {\r\n    margin-top: 15px;\r\n    padding: 15px;\r\n    background-color: #dee2e6;\r\n    border-radius: 8px;\r\n}\r\n\r\n.reminder-container-ibeuat-mobile {\r\n    display: none;\r\n}\r\n\r\n.reminder-text {\r\n    font-size: 16px;\r\n    color: #333;\r\n    margin-right: 20px;\r\n}\r\n\r\n.reminder-container-ibeuat-mobile .reminder-text {\r\n    color: #fff;\r\n    margin: 20px auto 0px auto;\r\n    display: table;\r\n    text-align: center;\r\n}\r\n\r\n.highlight,\r\n.date {\r\n    color: #E0396D;\r\n    font-family: flynas-Bold;\r\n    font-weight: bold;\r\n}\r\n\r\n.search-button {\r\n    border: 2px solid #E0396D;\r\n    color: #E0396D;\r\n    background: transparent;\r\n    border-radius: 5px;\r\n    padding: 5px 20px;\r\n    font-family: flynas-Medium;\r\n    cursor: pointer;\r\n    margin-top: -4px;\r\n    float: right;\r\n}\r\n\r\n.search-button:hover {\r\n    background-color: #E0396D;\r\n    color: #fff;\r\n}\r\n\r\n@media (max-width: 992px) {\r\n    .search-button {\r\n        width: 100%;\r\n        margin-top: 20px;\r\n        padding: 10px;\r\n        float: none;\r\n    }\r\n\r\n    .reminder-text {\r\n        display: block;\r\n        text-align: center;\r\n    }\r\n}\r\n\r\n@media (max-width: 912px) {\r\n    #bx-11a83a40-82d4-413a-9a6b-1b92479700ee {\r\n        padding-right: 12px;\r\n        padding-left: 12px;\r\n        margin-top: 2px;\r\n    }\r\n\r\n    .reminder-container-ibeuat-mobile {\r\n        display: block;\r\n    }\r\n\r\n    .reminder-container {\r\n        display: none;\r\n    }\r\n}",html:'\x3c!-- define the structure and content of your Experience in HTML e.g.--\x3e\n\x3c!-- Use dynamic Guest variables, type ctrl+space or guest to explore available entities.--\x3e\n\x3c!-- Type \'d\' to see decisioning helpers --\x3e\n{{!--CMS site version--}}\n<div class="reminder-container">\n <span class="reminder-text">Hello Guest! Don\'t forget to book your flights to <span class="highlight">RUH</span> seats are still available on your dates <span class="date">22 Jun 24</span></span>\n <a class="search-button">Search</a>\n</div>\n{{!--IBEUAT site version: this site has a different vesrion because of how it behaves on mobile--}}\n<div class="reminder-container-ibeuat-mobile">\n <span class="reminder-text">Hello Guest! Don\'t forget to book your flights to <span class="highlight">RUH</span> seats are still available on your dates <span class="date">22 Jun 24</span></span>\n <a class="search-button">Search</a>\n</div>',js:'// You can choose how you want to add your HTML by using insertHTMLBefore, insertHTMLAfter, or replaceHTML methods\r\n// e.g insertHTMLAfter(\'.someClassName\'); or insertHTMLAfter(\'body\'); or replaceHTML(\'#myPageId\')\r\n\r\n(function () {\r\n\r\n    console.log("UC1.1")\r\n    //   alert("UC1.1")\r\n    let href = window.location.href;\r\n\r\nvar engText = "";\r\nvar arText = "";\r\nvar engTextMobile = "";\r\nvar arTextMobile = "";\r\nvar isGuest = false;\r\n\r\n    // Variables from the API tab/DM will be null if not present.\r\n    let lang = document.documentElement.lang\r\n    let culture = "en-US";\r\n    if (document.body.classList.contains("arabic")) {\r\n        lang = "ar";\r\n        culture = "en-GB";\r\n    }\r\n\r\n    const origin = "{{DM.departure}}"\r\n    const destination = "{{DM.arrival}}"\r\n    const departureDate = "{{DM.departureDate}}"\r\n    const returnDate = "{{DM.returnDate}}"\r\n    const currency = "{{DM.currency}}"\r\n    const lowestFarePrice = "{{DM.lowestFare}}"\r\n    const adultCount = "{{DM.adultCount}}"\r\n    const childCount = "{{DM.childCount}}"\r\n    const infantCount = "{{DM.infantCount}}"\r\n    const flightMode = "{{DM.flightMode}}"\r\n\r\n    if (flightMode === "multi" || lowestFarePrice.toString() === "99999999" ||  destination === undefined || departureDate === undefined) {\r\n        console.log("uc1.1 return");\r\n        return 0;\r\n    }\r\n    else {\r\n\r\n        // test\r\n        //   destination = "AHB";\r\n        //   lowestFarePrice = "200";\r\n        //   currency = "USD";\r\n\r\n        let guestName = "{{DM.name}}"\r\n        // Client wants to use "Guest" if user doesn\'t have a firstName attribute, this function satisfies this condition.\r\n        if ((guestName === "" || guestName === "null") && lang == "en") {\r\n            guestName = "Guest"\r\n            isGuest = true;\r\n        } else if ((guestName === "" || guestName === "null") && lang == "ar") {\r\n            guestName = "ضيفنا العزيز"\r\n            isGuest = true;\r\n        }\r\n        let link = "";\r\n        if (window.location.hostname === \'www.flynas.com\') {\r\n            link = `https://booking.flynas.com/#/booking/search-redirect?origin=${origin}&destination=${destination}&origin1=undefined&destination1=undefined&currency=${currency}&departureDate=${departureDate}&returnDate=${returnDate}&flightMode=${flightMode}&adultCount=${adultCount}&childCount=${childCount}&infantCount=${infantCount}&culture=${culture}`;\r\n        }\r\n        else {\r\n            link = `https://ibeuat.flynas.com/flynascdp/#/booking/search-redirect?origin=${origin}&destination=${destination}&origin1=undefined&destination1=undefined&currency=${currency}&departureDate=${departureDate}&returnDate=${returnDate}&flightMode=${flightMode}&adultCount=${adultCount}&childCount=${childCount}&infantCount=${infantCount}&culture=${culture}`;\r\n            //   multicity = `https://ibeuat.flynas.com/IBE-5600/#/booking/search-redirect?origin=RUH      &destination=SZG           &origin1=SZG      &destination1=ADD      &currency=USD        &departureDate=2024-09-24&returnDate=2024-10-01&flightMode=multi&adultCount=1&childCount=0&infantCount=0&promoCode=&naSmiles=false&specialDiscount=null&culture=en-US&reference=undefined&multicityObject=%5B%5D&locationsource=SA`\r\n            // onewey =   `https://ibeuat.flynas.com/IBE-5600/#/booking/search-redirect?origin=AHB      &destination=JED           &origin1=undefined&destination1=undefined&currency=USD        &departureDate=2024-09-24&returnDate=2024-09-24&flightMode=oneway&adultCount=1&childCount=0&infantCount=0&promoCode=&naSmiles=false&specialDiscount=null&culture=en-US&reference=undefined&multicityObject=%5B%5D&locationsource=SA`\r\n\r\n        }\r\n        // Copy and translations\r\n        const airportsTranslated = {\r\n        "ABJ": "أبيدجان",\r\n        "ABT": "الباحة",\r\n        "ABV": "ابوجا",\r\n        "ADA": "أضنة",\r\n        "ADB": "ازمير",\r\n        "ADD": "أديس أبابا",\r\n        "AHB": "أبها",\r\n        "AJF": "الجوف",\r\n        "ALA": "ألماتي",\r\n        "ALG": "الجزائر",\r\n        "AMD": "أحمدأباد",\r\n        "AMM": "عَمَّان",\r\n        "AMS": "أمستردام",\r\n        "AQI": "القيصومة",\r\n        "ASM": "أسمرة",\r\n        "ATH": "أثينا",\r\n        "ATQ": "امريتسار",\r\n        "ATZ": "أسيوط",\r\n        "AUH": "أبو ظبي",\r\n        "AYT": "أنطاليا",\r\n        "BAH": "البحرين",\r\n        "BBI": "بوبانيسوار",\r\n        "BCN": "برشلونة",\r\n        "BCU": "بوتشي",\r\n        "BEG": "بلغراد",\r\n        "BER": "برلين",\r\n        "BEY": "بيروت",\r\n        "BGW": "بغداد",\r\n        "BGY": "ميلان",\r\n        "BHH": "بيشة",\r\n        "BHK": "بخاري",\r\n        "BHO": "بوبال",\r\n        "BJL": "بانجول",\r\n        "BJV": "بودروم",\r\n        "BKK": "بانكوك",\r\n        "BKO": "باماكو",\r\n        "BLR": "بنغالور",\r\n        "BOM": "مومباي",\r\n        "BOY": "بوبوديولاسو",\r\n        "BRU": "بروكسل",\r\n        "BUD": "بودابست",\r\n        "BUS": "باتومي",\r\n        "EG1": "القاهرة",\r\n        "CAI": "القاهرة",\r\n        "CCJ": "كوزهيكود",\r\n        "CCU": "كالكوتا",\r\n        "CDG": "باريس",\r\n        "CGK": "جاكرتا",\r\n        "CGN": "كولونيا",\r\n        "CIT": "شيمكنت",\r\n        "CMB": "كولومبو",\r\n        "CMN": "الدار البيضاء",\r\n        "COK": "كوتشن",\r\n        "CPH": "كوبنهاغن",\r\n        "CPT": "مطاركاريوتابيرا",\r\n        "CZL": "قسنطينة",\r\n        "DAC": "دكا",\r\n        "DAR": "دارالسلام",\r\n        "DEL": "دلهي",\r\n        "DKR": "داكار",\r\n        "DME": "موسكو",\r\n        "DMM": "الدمام",\r\n        "DNZ": "دنيزلي",\r\n        "DOH": "الدوحة",\r\n        "DSS": "دياس",\r\n        "DUS": "ألمانيا",\r\n        "DWC": "دبي-آلمكتوم",\r\n        "AE1": "دبي",\r\n        "DXB": "دبي",\r\n        "DYU": "دوشانبي",\r\n        "EAM": "نجران",\r\n        "EBB": "عنتيبي",\r\n        "EBL": "أربيل",\r\n        "EDI": "إدنبرة",\r\n        "EDO": "ادرميت",\r\n        "ELQ": "القصيم",\r\n        "ESB": "أنقرة",\r\n        "EVN": "يريفان",\r\n        "FCO": "روما",\r\n        "FEG": "فيرجانا",\r\n        "FNA": "فريتاون",\r\n        "FRA": "فرانكفورت",\r\n        "BSZ": "بيشكيك",\r\n        "GAU": "جواهاتي",\r\n        "GAY": "غايا",\r\n        "GGR": "غاروي",\r\n        "GIZ": "جازان",\r\n        "GMO": "لاوانتي",\r\n        "GOI": "غوا",\r\n        "GOU": "غاروا",\r\n        "GRU": "ساوباولو",\r\n        "GVA": "جنيف",\r\n        "GYD": "باكو",\r\n        "GZT": "غازي عنتاب",\r\n        "HAH": "موروني",\r\n        "HAJ": "هانوفرلانغنهاغن",\r\n        "HAM": "هامبورغ",\r\n        "HAS": "حائل",\r\n        "HBE": "الإسكندرية",\r\n        "HDM": "ايرانهمدان",\r\n        "HKG": "هونجكونج",\r\n        "HMB": "سوهاج",\r\n      