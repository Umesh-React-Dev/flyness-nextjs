    <!DOCTYPE html>
    <html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Boarding Pass</title>
        
           <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        font-family: "Arial", sans-serif;
        background: white;
        padding: 20px;
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 100vh;
      }

      .ticket-box {
        position: relative;
        width: 240px;
        box-shadow: 0 0.0625rem 0.625rem 0 rgba(0, 0, 0, 0.12);
        border-radius: 0.75rem;
        margin: 0 auto 0;
        background-color: white;

      }

      .ticket-box.min-height {
        min-height: 10.625rem;
      }

      .ticket-box .top {
        position: relative;
        padding: 0.5rem 0.8125rem;
        border-radius: 0.75rem 0.75rem 0 0;
        border: 0.0625rem solid transparent;
        border-bottom: none;
        width: 100%;
        
        /* background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); */
        /* color: white; */
      }
      .ticket-box .top:after {
        content: "";
        width: 100%;
        position: absolute;
        bottom: -0.0625rem;
        left: 0;
        right: 0;
        height: 0.0625rem;
        background: linear-gradient(
          90deg,
          rgba(255, 255, 255, 0) 0%,
          #e8eff0 100%
        );

        z-index: 2;
      }

      .ticket-box .top.with-chip {
        display: flex;
        align-items: center;
        justify-content: space-between;
      }

      .logo-top-icon {
        width: 2.875rem;
        height: 1.1875rem;
        display: inline-block;
        vertical-align: middle;
        background: url(/public/icons/logo-top-icon.svg) no-repeat center;
        background-size: contain;
      }

      .ticket-info-row {
        justify-content: space-between;
        padding: 0.75rem 0.8125rem;
        display: flex;
        align-items: center;
      }

      .h1 {
        font-size: 1.5rem;
        font-weight: bold;
        color: #2d2d2d;
        margin-bottom: 0.5rem;
      }

      .fs10 {
        font-size: 10px;
      }
      .fs11 {
        font-size: 11px;
      }
      .fs12 {
        font-size: 12px;
      }
      .fw500 {
        font-weight: 500;
      }
      .fw700 {
        font-weight: 700;
      }

      .mb4 {
        margin-bottom: 4px;
      }
      .mb6 {
        margin-bottom: 6px;
      }
      .mt2 {
        margin-top: 2px;
      }

      .text-center {
        text-align: center;
      }

      .plane-line-icon {
        width: 4.125rem;
        height: 0.875rem;
        display: inline-block;
        vertical-align: middle;
        background: url(/public/icons/plane-line-icon.svg) no-repeat center;
        background-size: contain;
        margin: 0 auto 6px;
      }

      .text-grey150 {
        color: #8e8e8e;
      }
      .text-grey400 {
        color: #606060;
      }
      .text-text {
        color: #606060;
      }

      .md {
        font-size: 16px;
      }
      .xs {
        font-size: 14px;
      }

      .hr-dashed {
        border: none;
        border-top: 1px dashed #e5e5e5;
        margin: 0 20px;
      }

      .border-title {
        padding: 20px 20px 10px;
        border-bottom: 1px solid #e5e5e5;
      }

      .pt10 {
        padding-top: 10px;
      }
      .mb10 {
        margin-bottom: 10px;
      }

      .card-wrapper {
        padding: 0 12px;
      }

      .grey-inner {
        background-color: #f6f9f9;
        border-radius: 8px;
        padding: 0.75rem;
      }

      .border-title {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: space-between;
        font-size: 0.625rem;
        letter-spacing: 0.0938rem;
        text-transform: uppercase;
        padding: 0 0.75rem;
        color: grey;
        border-left: 1px solid transparent;
        border-right: 1px solid transparent;
        border-bottom: none;
        margin: 16px 0 10px;
      }

      .border-title:before,
      .border-title:after {
        content: "";
        display: inline-block;
        height: 0.0625rem;
        width: auto;
        flex: 1 1;
      }

      .border-title:before {
        margin-inline-end: 0.5rem;
        background: linear-gradient(to left, grey, transparent);
      }

      .border-title:after {
        background: linear-gradient(to right, grey, transparent);
        margin-inline-start: 0.5rem;
      }

      .row-sm {
        display: flex;
        margin-bottom: 15px;
      }

      .col-5 {
        flex: 0 0 41.666667%;
      }
      .col-2 {
        flex: 0 0 16.666667%;
      }
      .text-end {
        text-align: right;
      }

      .solid {
        border: none;
        border-top: 1px solid #e5e5e5;
        margin: 15px 0;
      }

      .qr-wrapper {
        padding: 16px 12px 12px;
        text-align: center;
        /* border-top: 1px solid #e5e5e5; */
      }

      .qr-code {
        width: 120px;
        // height: 120px;
        display: block;
        margin: 0 auto;
        border-radius: 8px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
      }

      .code-type-label {
        font-size: 12px;
        opacity: 0.7;
        margin-top: 8px;
        text-transform: uppercase;
      }
    </style>
    </head>
    <body>
        <div class="ticket-box min-height">
            <div class="top with-chip">
                <div>
                    <i class="logo-top-icon"></i>
                </div>
                <p class="fs10 fw500">PNR ${_l(t.pnr)}</p>
            </div>
            
            <div class="ticket-info-row">
                <div>
                    <h2 class="h1">${_l(t.from.title)}</h2>
                    <p class="fs12 mb4 text-grey150">${_l(s.date)}</p>
                    <p class="md fw700">${_l(s.time)}</p>
                </div>
                
                <div class="text-center">
                    <i class="plane-line-icon mb6"></i>
                    <p class="text-grey400 mb4 fs11 mt2 fw700">Direct</p>
                    <p class="fs12">${_l(o)}</p>
                </div>

                <div>
                    <h2 class="h1">${_l(t.to.title)}</h2>
                    <p class="fs12 mb4 text-grey150">${_l(a.date)}</p>
                    <p class="md fw700">${_l(a.time)}</p>
                </div>
            </div>
            
            <hr class="hr-dashed" />
          
            <div class="border-title pt10 mb10">
                <span>Passenger details</span>
            </div>
            
            <div class="card-wrapper">
                <div class="grey-inner">
                    <div class="row-sm">
                        <div class="col-5">
                            <p class="fs10 text-text mb4">Name</p>
                            <p class="xs fw700">${_l(t.passenger_name)}</p>
                        </div>
                        <div class="col-5">
                            <p class="fs10 text-text mb4">Departs</p>
                            <p class="xs fw700">${_l(s.date)}, ${_l(s.time)}</p>
                        </div>
                        <div class="col-2 text-end">
                            <p class="fs10 text-text mb4">Flight</p>
                            <p class="xs fw700">${_l(t.flight_code)}</p>
                        </div>
                    </div>
                    <hr class="solid" />
                    <div class="row-sm">
                        <div class="col-5">
                            <p class="fs10 text-text mb4">Sequence</p>
                            <p class="xs fw700">${_l(t.sequence)}</p>
                        </div>
                        <div class="col-5">
                            <p class="fs10 text-text mb4">Zone</p>
                            <p class="xs fw700">${_l(t.zone)}</p>
                        </div>
                        <div class="col-2 text-end">
                            <p class="fs10 text-text mb4">Seat</p>
                            <p class="xs fw700">${_l(t.seat)}</p>
                        </div>
                    </div>
                </div>
            </div> 

            <div class="qr-wrapper">
                <img src="${n}" alt="Boarding Pass ${_l(r===ul.QRCODE?"QR Code":"Barcode")}" class="${_l(r===ul.QRCODE?"qr-code":"bar-code")}" />
            </div>
        </div>
    </body>
    </html>
