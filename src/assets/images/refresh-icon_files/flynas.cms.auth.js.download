function getCookie(name) {
    let match = new RegExp('(^| )' + name + '=([^;]+)').exec(document.cookie);
    if (match) return match[2];
}

document.addEventListener("DOMContentLoaded", function () {
    let cmsudCookie = getCookie("_cmsud");

    if (cmsudCookie) {
        try {
            let decodedCookie = decodeURIComponent(cmsudCookie);
            let userData = JSON.parse(decodedCookie);

            let loggedOutView = null;
            let loggedInView = null;
            let userName = null;

            if (userData?.firstName && userData.lastName) {
                let loginContainer = document.getElementById("login-container");
                if (loginContainer) {
                    loggedOutView = loginContainer.querySelector('.logged-out-view');
                    loggedInView = loginContainer.querySelector('.logged-in-view');
                    userName = loggedInView.querySelector('.user-name');

                    userName.textContent = `${userData.firstName} ${userData.lastName}`;

                    // Show logged-in, hide logged-out using classes
                    $(loggedOutView)
                        .addClass('d-none')
                        .removeClass('d-flex');

                    $(loggedInView)
                        .removeClass('d-none')
                        .addClass('d-flex');

                    loginContainer.classList.add("logged-in");
                }

                let loginContainerResponsive = document.getElementById("login-container-responsive");
                if (loginContainerResponsive) {
                    loggedOutView = loginContainerResponsive.querySelector('.logged-out-view');
                    loggedInView = loginContainerResponsive.querySelector('.logged-in-view');
                    userName = loggedInView.querySelector('.user-name');

                    userName.textContent = `${userData.firstName} ${userData.lastName}`;

                    $('.logged-in-view #userMenu .user-name').text(userName.textContent);

                    // Show logged-in, hide logged-out using classes
                    $(loggedOutView)
                        .addClass('d-none')
                        .removeClass('d-flex');

                    $(loggedInView)
                        .removeClass('d-none')
                        .addClass('d-flex');

                    loginContainerResponsive.classList.add("logged-in");
                }
            }
        } catch (e) {
            console.error("Error parsing _cmsud cookie:", e);
        }
    }
});

// wait for page
$(function(){

    // OPEN / CLOSE on icon click
    $(document).on('click', '#userIcon', function(e){
        e.preventDefault();
        e.stopPropagation();
        $('#userMenu').toggle();
    });

    // CLOSE when clicking outside
    $(document).on('click', function(){
        $('#userMenu').hide();
    });

    // PREVENT closing when clicking inside menu
    $(document).on('click', '#userMenu', function(e){
        e.stopPropagation();
    });

});
